&НаКлиенте
Процедура смарт_УстановитьСтатусПодписанНеПодписанПосле(Команда)
//++ смарт:Каратеев #1573 10.12.2023 //Изменены реквизиты формы после обновления. Процедура добавлена вместо смарт_УстановитьСтатусПодписанПосле
	Если Элементы.Список.ВыделенныеСтроки.Количество()=1 Тогда
		ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
		ТекущаяСтрока = Элементы.Список.ДанныеСтроки(ВыделенныеСтроки[0]);
		ДанныеПроверки=смартПолучитьДанныеПроверкиДляПодписиДокумента(Элементы.Список.ВыделенныеСтроки[0]);
		Если ДанныеПроверки.Результат И ТекущаяСтрока.Подписан Тогда
			смартСкопироватьВБуферОбмена(Неопределено);
			смартУстановитьПодписавшегоДокумент(Элементы.Список.ВыделенныеСтроки[0]);
		Иначе
			Для Каждого Ошибка Из ДанныеПроверки.Ошибки Цикл
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибка);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
//-- смарт:Каратеев #1573 10.12.2023 //Изменены реквизиты формы после обновления.
КонецПроцедуры

