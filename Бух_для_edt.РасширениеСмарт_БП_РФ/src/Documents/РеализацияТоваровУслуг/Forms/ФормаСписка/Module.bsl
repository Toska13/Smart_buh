#Область ДоработкиСмарт

//Фролов+
&НаКлиенте
Процедура смартСкопироватьВБуферОбмена(Команда)
	Если  Элементы.Список.ВыделенныеСтроки.Количество()=1 И Элементы.Список.ТекущиеДанные.Подписан Тогда
		смартДобавитьРеквизитБуфераОбмена();
		//После перехода на 8.3.14 и выше, функционал clipboardData работать не будет.
		//Нужно переделать на процедуры WebKit
		Если Элементы.БФ.Документ.parentWindow = Неопределено Тогда
			Сообщить("Копирование из списка не доступно. Для копирования наименования войдите в документ и скопируйте наименование из поля внизу документа");
		Иначе
			Элементы.БФ.Документ.parentWindow.clipboardData.SetData("Text",смартПолучитьИмяФайлаДляБуфераОбмена(Элементы.Список.ВыделенныеСтроки[0]));
		КонецЕсли;	
		смартУдалитьРеквизитБуфераОбмена();
	КонецЕсли;
КонецПроцедуры

//Фролов+
&НаСервереБезКонтекста
Функция смартПолучитьДанныеПроверкиДляПодписиДокумента(Ссылка)
	Возврат Документы.РеализацияТоваровУслуг.смартЕстьВозможностьПодписатьДокумент(Ссылка,
			Ссылка.СчетНаОплатуПокупателю,
			УчетНДСПереопределяемый.НайтиПодчиненныеСчетаФактурыВыданныеНаРеализацию(Ссылка)[Ссылка]);
КонецФункции

//Фролов+
&НаСервереБезКонтекста
Процедура смартУстановитьПодписавшегоДокумент(Ссылка)
	Документы.РеализацияТоваровУслуг.смартУстановитьПодписавшегоДокумент(Ссылка);
КонецПроцедуры	

//Фролов+
&НаСервере
Функция смартПолучитьИмяФайлаДляБуфераОбмена(Ссылка)
	СчетФактура=УчетНДСПереопределяемый.НайтиПодчиненныеСчетаФактурыВыданныеНаРеализацию(Ссылка)[Ссылка];
	ИмяКонтрагента=Лев(СокрЛП(СтрЗаменить(Ссылка.Контрагент.Наименование,"ООО","")),100);
	Возврат "СФ "+СчетФактура.Номер+" "+Формат(СчетФактура.Дата,"ДЛФ=D")+" (Счет "+Ссылка.СчетНаОплатуПокупателю.Номер+" "+Формат(Ссылка.СчетНаОплатуПокупателю.Дата,"ДЛФ=D")+") "+ИмяКонтрагента;
КонецФункции	

//Фролов+
&НаСервере
Процедура смартДобавитьРеквизитБуфераОбмена()
	М=Новый Массив;
	М.Добавить(Новый РеквизитФормы("БФ",Новый ОписаниеТипов("Строка")));
	ЭтаФорма.ИзменитьРеквизиты(М);
	Эл=ЭтаФорма.Элементы.Добавить("БФ",Тип("ПолеФормы"));
	Эл.Вид=ВидПоляФормы.ПолеHTMLДокумента;
	Эл.Высота=1; Эл.Ширина=1;
	Эл.ПутьКДанным="БФ";
КонецПроцедуры

//Фролов+
&НаСервере
Процедура смартУдалитьРеквизитБуфераОбмена()
	ЭтаФорма.Элементы.Удалить(Элементы.Найти("БФ"));
	М=Новый Массив;
	М.Добавить("БФ");
	ЭтаФорма.ИзменитьРеквизиты(,М);
КонецПроцедуры

//++ смарт:ММ 572 01.07.2021
&НаСервере
Процедура смартДобавитьЭлементыПрограммно()
	
	// Изменение запроса динамического списка
	
	ТекстПоиска = "ДокументРеализацияТоваровУслуг.Ссылка КАК Ссылка,";
	ТекстЗамены = "ДокументРеализацияТоваровУслуг.Ссылка КАК Ссылка,
	|ЕСТЬNULL(смартСформированныеПакетыПФ.ПакетСформирован, ЛОЖЬ) КАК смартПакетСформирован,";
	Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, ТекстПоиска, ТекстЗамены);
	
	ТекстПоиска = "Документ.РеализацияТоваровУслуг КАК ДокументРеализацияТоваровУслуг";
	ТекстЗамены = "Документ.РеализацияТоваровУслуг КАК ДокументРеализацияТоваровУслуг
	|	{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСформированныеПакетыПФ КАК смартСформированныеПакетыПФ
	|	ПО ДокументРеализацияТоваровУслуг.Ссылка = смартСформированныеПакетыПФ.Документ}"; 
	Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, ТекстПоиска, ТекстЗамены);
	
	// Добавление колонки
	
	НоваяКолонка = Элементы.Вставить("смартПакетСформирован", Тип("ПолеФормы"), Элементы.Список, Элементы.Подписан); 
	НоваяКолонка.Заголовок = "Пакет сформирован"; 
	НоваяКолонка.ПутьКДанным = "Список.смартПакетСформирован"; 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеФлажка;
	НоваяКолонка.Подсказка = "Печатные формы сохранены в каталог склада Адмирал";
		
	// Добавление команды
	
	НоваяКоманда = Команды.Добавить("смартСформироватьПакетДокументов");
	НоваяКоманда.Действие = "смартСформироватьПакетДокументов";
	НоваяКоманда.Заголовок = "Сформировать пакет документов (смарт)";
	
	НовыйЭлемент = Элементы.Добавить("смартСформироватьПакетДокументов",
									Тип("КнопкаФормы"),
									Элементы.ГруппаВажныеКоманды);
	НовыйЭлемент.ИмяКоманды = "смартСформироватьПакетДокументов";
	
КонецПроцедуры //-- смарт:ММ 01.07.2021

//++ смарт:ММ 572 01.07.2021
&НаКлиенте
Процедура смартСформироватьПакетДокументов(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	МассивИД = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		МассивИД.Добавить(ВыделеннаяСтрока);
	КонецЦикла;
	
	Для Каждого ИД Из МассивИД Цикл		
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ИД);
		ДокСсылка = ДанныеСтроки.Ссылка;
		
		смартОбщегоНазначенияКлиент.СформироватьПакетДокументов(ДокСсылка);		
	КонецЦикла;	
	
	Элементы.Список.Обновить();
	
КонецПроцедуры //-- смарт:ММ 01.07.2021

//++ #Б7936 смарт: Шляпников 28.08.2026 / Маркировка радиоэлектронной продукции. Форма списка РТУ 1С БП.
&НаСервере
Процедура смартДобавитьИндикациюМаркировкиВСписок()
	
	ТекстПоиска = "ЕСТЬNULL(смартСформированныеПакетыПФ.ПакетСформирован, ЛОЖЬ) КАК смартПакетСформирован,";
	ТекстЗамены =
	"ЕСТЬNULL(смартСформированныеПакетыПФ.ПакетСформирован, ЛОЖЬ) КАК смартПакетСформирован,
	|ЕСТЬNULL(смартМаркируемыеДокументы.ЕстьМаркируемаяПродукция, ЛОЖЬ) КАК смартЕстьМаркируемаяПродукция,
	|ЕСТЬNULL(смартДокументыСКодамиМаркировки.КодыМаркировкиЗагружены, ЛОЖЬ) КАК смартКодыМаркировкиЗагружены,";
	Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, ТекстПоиска, ТекстЗамены);
	
	ТекстПоиска =
	"Документ.РеализацияТоваровУслуг КАК ДокументРеализацияТоваровУслуг
	|	{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСформированныеПакетыПФ КАК смартСформированныеПакетыПФ
	|	ПО ДокументРеализацияТоваровУслуг.Ссылка = смартСформированныеПакетыПФ.Документ}";
	ТекстЗамены =
	"Документ.РеализацияТоваровУслуг КАК ДокументРеализацияТоваровУслуг
	|	{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСформированныеПакетыПФ КАК смартСформированныеПакетыПФ
	|	ПО ДокументРеализацияТоваровУслуг.Ссылка = смартСформированныеПакетыПФ.Документ}
	|	{ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			РеализацияТоваровУслугТовары.Ссылка КАК Ссылка,
	|			ИСТИНА КАК ЕстьМаркируемаяПродукция
	|		ИЗ
	|			Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочник
	|				ПО РеализацияТоваровУслугТовары.Номенклатура = НоменклатураСправочник.Ссылка
	|		ГДЕ
	|			(НоменклатураСправочник.ВидМаркировки <> ЗНАЧЕНИЕ(Перечисление.ВидыПродукцииИС.ПустаяСсылка)
	|				ИЛИ НоменклатураСправочник.смартОбязательнаяМаркировка)
	|		СГРУППИРОВАТЬ ПО
	|			РеализацияТоваровУслугТовары.Ссылка) КАК смартМаркируемыеДокументы
	|		ПО ДокументРеализацияТоваровУслуг.Ссылка = смартМаркируемыеДокументы.Ссылка}
	|	{ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка КАК Ссылка,
	|			ИСТИНА КАК КодыМаркировкиЗагружены
	|		ИЗ
	|			Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК РеализацияТоваровУслугШтрихкодыУпаковок
	|		ГДЕ
	|			РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки <> ЗНАЧЕНИЕ(Справочник.ШтрихкодыУпаковокТоваров.ПустаяСсылка)
	|		СГРУППИРОВАТЬ ПО
	|			РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка) КАК смартДокументыСКодамиМаркировки
	|		ПО ДокументРеализацияТоваровУслуг.Ссылка = смартДокументыСКодамиМаркировки.Ссылка}";
	Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса, ТекстПоиска, ТекстЗамены);
	
	СвойстваКолонки = Новый Структура("Подсказка", "В документе есть позиции маркируемой продукции");
	смартФормированиеИнтерфейса.СздПолеФлажок(ЭтаФорма,
		"смартЕстьМаркируемаяПродукция",
		"Список",
		"Маркируемый товар",
		,
		"Список.смартЕстьМаркируемаяПродукция",
		СвойстваКолонки,
		,
		"Подписан");
	
	СвойстваКолонки = Новый Структура("Подсказка", "Коды маркировки загружены в документ");
	смартФормированиеИнтерфейса.СздПолеФлажок(ЭтаФорма,
		"смартКодыМаркировкиЗагружены",
		"Список",
		"Коды маркировки",
		,
		"Список.смартКодыМаркировкиЗагружены",
		СвойстваКолонки,
		,
		"Подписан");
	
КонецПроцедуры

//++ #Б7936 смарт: Шляпников 28.08.2026 / Маркировка радиоэлектронной продукции. Форма списка РТУ 1С БП.
&НаСервере
Процедура смартНастроитьУсловноеОформлениеМаркировки()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Список");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Список.смартЕстьМаркируемаяПродукция", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Список.смартКодыМаркировкиЗагружены", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.СветлоРозовый);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Список");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Список.смартЕстьМаркируемаяПродукция", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
