#Область Документ_ПБДСПереводНаДругойСчет_Получение
&После("ПКО_Документ_ПБДСПереводНаДругойСчет_Получение_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Документ_ПБДСПереводНаДругойСчет_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	// Смарт Станчев+ доб. Статью ДДС
	Если ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПереводСДругогоСчета И ПолученныеДанные.СчетБанк.Код = "52" Тогда
		ПолученныеДанные.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("СФ-000038");
	КонецЕсли;
	// Смарт Станчев-
	
	// Смарт Фролов+ по заявке № 251 "Головное подразделение"
	смартЗаполнитьГоловноеПодразделение(?(ДанныеИБ=Неопределено,ПолученныеДанные,ДанныеИБ));
	// Фролов-
КонецПроцедуры
#КонецОбласти

&После("ЗаполнитьПравилаКонвертацииОбъектов")
Процедура смартРасш_ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации)
	//++ смарт:КМД #3_3 461 05.03.2021
	Если НаправлениеОбмена = "Получение" Тогда
		ДобавитьПКО_Документ_ПередачаТоваров_БезПер_Получение(ПравилаКонвертации);
	КонецЕсли;
	
	//Смарт Подкин Алексей 320 28.12.2020 
	Если НаправлениеОбмена = "Отправка" Тогда
		ДобавитьПКО_Документ_КорректировкаДолга_ВЗ_ЗА(ПравилаКонвертации);
		ДобавитьПКО_Документ_КорректировкаДолга_ВЗ_ПК(ПравилаКонвертации);
		ДобавитьПКО_Документ_КорректировкаДолга_ВЗ_ПЗ(ПравилаКонвертации);
		ДобавитьПКО_Документ_КорректировкаДолга_ВЗ_СЗ(ПравилаКонвертации);
	КонецЕсли;
	
	//++ #6654  смарт: Тимофеева 19.05.2026 / Взаиморасчеты. Часть5. Взаимозачет между тремя юр лицами.
	Если НаправлениеОбмена = "Отправка" Тогда
		ДобавитьПКО_Документ_Операция_ВЗСложный(ПравилаКонвертации);
	КонецЕсли; 
	//-- #6654  смарт: Тимофеева 19.05.2026

КонецПроцедуры

