	ОсновнаяСтатьяЗатрат = Справочники.СтатьиЗатрат.СтатьяЗатратПоНазначению("СписаниеМатериалов"); 

	Для Каждого СтрокаТаблицы Из Объект.Материалы Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ОтражениеВУСН) Тогда
			СтрокаТаблицы.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
		КонецЕсли;

	КонецЦикла;

	Если Объект.СведенияПрослеживаемости.Количество() > 0
		И Не ЗначениеЗаполнено(Объект.КодОперацииПрослеживаемости) Тогда
		Объект.КодОперацииПрослеживаемости = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.КодыОперацийПрослеживаемости.ПередачаВПроизводство");
	КонецЕсли;

    #Вставка
	//++ #1475 смарт: Ермаков / Переделать выгрузку списаний из УТ в БП по демозалу
	ЦельРасходаМатериалов = 
		Справочники.ЦелиРасходаМатериалов.НайтиПоНаименованию("Демонстрация оборудования и расходных материалов (Реклама нормируемая, прочие расходы ст 264 НК РФ)", Истина);	

	Подразделение = Справочники.ПодразделенияОрганизаций.НайтиПоНаименованию("Головной офис Москва",  Истина,, Объект.Организация);	
	СтатьяЗатрат = Справочники.СтатьиЗатрат.НайтиПоНаименованию("Расходы на рекламу (нормируемые) (прочие ст 264 НК РФ)", Истина); 
	СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
	
	Объект.СчетаУчетаЗатратВТаблице = Ложь;
	Объект.ПодразделениеОрганизации = Подразделение;
	Объект.ПодразделениеЗатрат = Подразделение;
	Объект.Субконто1 = СтатьяЗатрат;
	Объект.СпособУчетаНДС = СпособУчетаНДС;
	Объект.ЦельРасхода = ЦельРасходаМатериалов;	
	//-- #1475 смарт: Ермаков / Переделать выгрузку списаний из УТ в БП по демозалу
	#КонецВставки
	
КонецПроцедуры
