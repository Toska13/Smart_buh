	ОписаниеАналитики = УниверсальныйОбменЗагрузкаАналитики.НовыйОписаниеАналитикиОбъекта();
	УниверсальныйОбменЗагрузкаАналитики.ДобавитьАналитикуВОписание(ОписаниеАналитики, "Материалы", "СчетЗатрат", "Субконто", "ПодразделениеЗатрат");

	УниверсальныйОбменЗагрузкаАналитики.ЗаполнитьНезаполненнуюАналитику(Объект, ОписаниеАналитики);

	ДанныеОбъекта = Новый Структура("Дата,Организация,Склад");
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Объект);
	
	УстановитьПризнакПрослеживаемыйКомплект(Объект.Материалы, Объект.СведенияПрослеживаемости, "Номенклатура");
	
