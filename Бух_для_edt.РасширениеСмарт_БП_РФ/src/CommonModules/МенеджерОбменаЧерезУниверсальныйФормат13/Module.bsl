Функция смартПолучитьПредопределенныеДанные(Имя, Организация=Неопределено) //++ смарт:Подкин #886 03.02.2022 1
	//++ смарт:Подкин #886 03.02.2022 15:55:45
	Если Организация<>Неопределено Тогда
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 РАЗРЕШЕННЫЕ Объект ИЗ РегистрСведений.ДополнительныеСведения ГДЕ Свойство.Имя=&Имя И Значение=ИСТИНА И Объект.Владелец = &Организация");
		Запрос.УстановитьПараметр("Организация",Организация);
	Иначе
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 РАЗРЕШЕННЫЕ Объект ИЗ РегистрСведений.ДополнительныеСведения ГДЕ Свойство.Имя=&Имя И Значение=ИСТИНА");
	КонецЕсли;
	Запрос.УстановитьПараметр("Имя",Имя);
	//-- смарт:Подкин #886 03.02.2022 15:55:45  
	
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Возврат Рез.Объект;
	КонецЕсли;
	
	Возврат Неопределено;
