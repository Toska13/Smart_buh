	// Состояние документа 
	стрСостояниеДокумента = ?(ДанныеИБ.Проведен, "Проведен", "НеПроведен");
	стрСостояниеДокумента = ?(ДанныеИБ.ПометкаУдаления, "ПометкаУдаления", стрСостояниеДокумента);
	//++ #6644  смарт: Тимофеева 05.05.2026 / Взаиморасчеты. Часть2. Зачет авансов поставщику 
	//ДанныеXDTO.Вставить("AdditionalInfo", стрСостояниеДокумента); 
	AdditionalInfoВставить(ДанныеXDTO, "СостояниеДокумента", 		стрСостояниеДокумента);
	AdditionalInfoВставить(ДанныеXDTO, "ВидАвансаЗадолженности", 	Строка(ДанныеИБ.ВидАвансаЗадолженности));
	AdditionalInfoВставить(ДанныеXDTO, "ТипАвансаЗадолженности", 	Строка(ДанныеИБ.ТипАвансаЗадолженности));
	//-- #6644  смарт: Тимофеева 05.05.2026
	
	//Табличные части
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировкаДолгаДебиторскаяЗадолженность.Сумма КАК Сумма,
	|	КорректировкаДолгаДебиторскаяЗадолженность.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	КорректировкаДолгаДебиторскаяЗадолженность.ДоговорКонтрагента КАК Договор,
	|	КорректировкаДолгаДебиторскаяЗадолженность.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	КорректировкаДолгаДебиторскаяЗадолженность.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	КорректировкаДолгаДебиторскаяЗадолженность.ДоговорКонтрагента.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	КорректировкаДолгаДебиторскаяЗадолженность.Сделка КАК ДанныеДокументаРасчетов,
	|	КорректировкаДолгаДебиторскаяЗадолженность.Ссылка.ВидАвансаЗадолженности КАК ВидРасчетов
	|ИЗ
	|	Документ.КорректировкаДолга.ДебиторскаяЗадолженность КАК КорректировкаДолгаДебиторскаяЗадолженность
	|ГДЕ
	|	КорректировкаДолгаДебиторскаяЗадолженность.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КорректировкаДолгаКредиторскаяЗадолженность.Сумма КАК Сумма,
	|	КорректировкаДолгаКредиторскаяЗадолженность.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	КорректировкаДолгаКредиторскаяЗадолженность.ДоговорКонтрагента КАК Договор,
	|	КорректировкаДолгаКредиторскаяЗадолженность.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	КорректировкаДолгаКредиторскаяЗадолженность.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	КорректировкаДолгаКредиторскаяЗадолженность.ДоговорКонтрагента.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	КорректировкаДолгаКредиторскаяЗадолженность.Сделка КАК ДанныеДокументаРасчетов,
	|	КорректировкаДолгаКредиторскаяЗадолженность.Ссылка.ВидАвансаЗадолженности КАК ВидРасчетов
	|ИЗ
	|	Документ.КорректировкаДолга.КредиторскаяЗадолженность КАК КорректировкаДолгаКредиторскаяЗадолженность
	|ГДЕ
	|	КорректировкаДолгаКредиторскаяЗадолженность.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	//Дебиторская
	ТаблицаДебиторка = РезультатЗапроса[0].Выгрузить();
	Если ТаблицаДебиторка.Количество() > 0 Тогда
		ЗаполнитьПКОДокументаРасчетовДляОтправки(ТаблицаДебиторка, "ОчищатьНеНайденные");
		ДанныеXDTO.Вставить("ДебиторскаяЗадолженность", ТаблицаДебиторка);
	КонецЕсли;
	
	ТаблицаКредиторка = РезультатЗапроса[1].Выгрузить();
	Если ТаблицаКредиторка.Количество() > 0 Тогда
		ЗаполнитьПКОДокументаРасчетовДляОтправки(ТаблицаКредиторка, "ОчищатьНеНайденные");
		ДанныеXDTO.Вставить("КредиторскаяЗадолженность", ТаблицаКредиторка);
	КонецЕсли;
КонецПроцедуры

