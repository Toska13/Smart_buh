Функция смартПолучитьВедомость(СуммаДокумента, Дата)
	
	//++ смарт:ЩукинВВ #2570 473; 410; 251 13.03.2020
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВедомостьНаВыплатуЗарплаты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВедомостьНаВыплатуЗарплаты КАК ВедомостьНаВыплатуЗарплаты
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(ВедомостьНаВыплатуЗарплаты.Дата, ДЕНЬ) = &Дата
	|	И ВедомостьНаВыплатуЗарплаты.СуммаДокумента = &СуммаДокумента";
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));
	Запрос.УстановитьПараметр("СуммаДокумента", СуммаДокумента);
	
	Выборка = Запрос.Выполнить(); 
	
	Если Выборка.Пустой() Тогда
		Возврат Неопределено; 
	Иначе
		Рез = Выборка.Выбрать(); 
		Если рез.Количество() > 1  Тогда
			Возврат Неопределено; 
		КонецЕсли;
		
		Рез.Следующий(); 
				
		Возврат Рез.Ссылка; 
	КонецЕсли;
	//-- смарт:ЩукинВВ #2570 473; 410; 251 13.03.2020
	
КонецФункции	

