	//-- #5350 смарт: Ермаков 05.01.2026
	
	#КонецВставки
	
	СтавкаНДСЧислом = СоответствиеСтавок.Получить(СтавкаНДС);
	СтавкаНДСЧислом = ?(СтавкаНДСЧислом = Неопределено, 0, СтавкаНДСЧислом);
	
