//++ #Б7868 смарт: коды маркировки РТУ. Символ(29) на стороне УТ заменяется на ○.
&После("ПКО_Справочник_ШтрихкодыУпаковокТоваровИзСтр_Получение_ПриКонвертацииДанныхXDTO")
Процедура смарт_ПКО_Справочник_ШтрихкодыУпаковокТоваровИзСтр_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Если ТипЗнч(ПолученныеДанные.ЗначениеШтрихкода) = Тип("Строка")
		И СтрНайти(ПолученныеДанные.ЗначениеШтрихкода, "○") > 0 Тогда
		
		ПолученныеДанные.ЗначениеШтрихкода = СтрЗаменить(ПолученныеДанные.ЗначениеШтрихкода, "○", Символ(29));
		
	КонецЕсли;
	
КонецПроцедуры

&После("ПКО_Справочник_ШтрихкодыУпаковокТоваровИзСтр_Получение_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Справочник_ШтрихкодыУпаковокТоваровИзСтр_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	Если ДанныеИБ <> Неопределено
		И Не ЗначениеЗаполнено(ПолученныеДанные.ЗначениеШтрихкода)
		И ЗначениеЗаполнено(ДанныеИБ.ЗначениеШтрихкода) Тогда
		
		ПолученныеДанные.ЗначениеШтрихкода = ДанныеИБ.ЗначениеШтрихкода;
		
	КонецЕсли;
	
	// Типовой ставит PDF417 для длины <> 150 — для КМ ИСМП (GS1) нужен GS1_DataMatrix.
	Если ПолученныеДанные.ТипШтрихкода = Перечисления.ТипыШтрихкодов.PDF417
		И (СтрНайти(Строка(ПолученныеДанные.ЗначениеШтрихкода), Символ(29)) > 0
			Или СтрНачинаетсяС(Строка(ПолученныеДанные.ЗначениеШтрихкода), "01")) Тогда
		
		ПолученныеДанные.ТипШтрихкода = Перечисления.ТипыШтрихкодов.GS1_DataMatrix;
		
	КонецЕсли;
	
КонецПроцедуры

//++ #Б680 смарт: Шляпников 29.10.2024 / Печать документов в БП, ИТСМ 1961
&ИзменениеИКонтроль("ПКО_Документ_РеализацияТоваровУслуг_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Документ_РеализацияТоваровУслуг_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДобавитьПризнакЭтоНовый(ПолученныеДанные, ДанныеИБ);
	
	ЗапомнитьПрефиксДокумента(ПолученныеДанные, КомпонентыОбмена);
	ЗаполнитьКурсИКратностьВзаиморасчетов(ПолученныеДанные);
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные.СпособЗачетаАвансов) Тогда
		ПолученныеДанные.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
	КонецЕсли;
	
	ПолученныеДанные.Склад = СкладДляЗагрузки(ПолученныеДанные.Склад, КомпонентыОбмена.ПараметрыКонвертации);
	
	// Вид электронного документа не заполняется если документооборот не используется.
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьОбменЭД") Тогда
		ПолученныеДанные.ВидЭлектронногоДокумента = Неопределено; 
	КонецЕсли;
	
	УстановитьПризнакПроведенПриЗагрузке(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена.ПараметрыКонвертации);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
							ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
							
	РекомендуемыйВидОперации = Документы.РеализацияТоваровУслуг.РекомендуемыйВидОперации(ПолученныеДанные);
	Если ЗначениеЗаполнено(РекомендуемыйВидОперации) Тогда
		ПолученныеДанные.ВидОперации = РекомендуемыйВидОперации;
	КонецЕсли;
	
	ПолученныеДанные.ДокументБезНДС = ДокументБезНДС(ПолученныеДанные, ПолученныеДанные.Организация, ПолученныеДанные.Дата, "Товары,Услуги,АгентскиеУслуги");
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ОблагаетсяНДСУПокупателя")
		И ЗначениеЗаполнено(ПолученныеДанные.ДоговорКонтрагента) Тогда
		КомпонентыОбмена.ПараметрыКонвертации.ДоговорыПродажиНДСИсчисляетсяПокупателем.Добавить(ПолученныеДанные.ДоговорКонтрагента);
	КонецЕсли;
	
	// Посчитать суммы документа и записать ее в соответствующий реквизит шапки для показа в журналах
	ПолученныеДанные.СуммаДокумента = УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДС(ПолученныеДанные, "Товары")
		+ УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДС(ПолученныеДанные, "Услуги")
		+ УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДС(ПолученныеДанные, "АгентскиеУслуги");
		
	#Вставка
	// Смарт Фролов+ по заявке № 251 "Головное подразделение"
	// Смарт Фролов+ Убрать адрес доставки, что бы при печати УПД подставлялся Юридической адрес. 
	//++ #Б1516 смарт: Шляпников 29.11.2024 / Синхронизация УТ-БП. Замена Обособленных подразделений
	смартЗаполнитьГоловноеПодразделение(ПолученныеДанные);
	ПолученныеДанные.АдресДоставки = "";
	
	Если НЕ ДанныеИБ = Неопределено Тогда
		смартЗаполнитьГоловноеПодразделение(ДанныеИБ);
		ДанныеИБ.АдресДоставки = "";
	КонецЕсли;
	//-- #Б1516 смарт: Шляпников 29.11.2024
	// Фролов-
	
	//++ #Б1242 смарт: Шляпников 29.10.2024 / Синхронизация УТ-БП, номенклатура с типом услуга
	Для каждого стрУслуга Из ПолученныеДанные.Услуги Цикл
		
		//++ #Б2986 смарт: Шляпников 27.05.2025 / Синхронизация в БП товаров с типом Услуга
		Если НЕ ЗначениеЗаполнено(стрУслуга.Номенклатура.ЕдиницаИзмерения)
			ИЛИ ВРЕГ(СокрЛП(стрУслуга.Номенклатура.ЕдиницаИзмерения)) = "ШТ"
			ИЛИ ВРЕГ(СокрЛП(стрУслуга.Номенклатура.ЕдиницаИзмерения)) = "УСЛУГА" Тогда
			
			стрУслуга.Количество = 0;
			стрУслуга.Цена = стрУслуга.Сумма;
			
		КонецЕсли;
		//-- #Б2986 смарт: Шляпников 27.05.2025
		
	КонецЦикла;
	//-- #Б1242 смарт: Шляпников 29.10.2024
	
	//++ #Б7892 смарт: Шляпников 24.08.2026 / Маркировка радиоэлектронной продукции. Контрагенты. Признак участника оборота.
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Дилер") Тогда
		смартЗаписатьСтатусКонтрагентаИСМППоПризнакуДилер(
			ПолученныеДанные.Контрагент,
			ПолученныеДанные.ДополнительныеСвойства.Дилер);
	КонецЕсли;
	//-- #Б7892 смарт: Шляпников 24.08.2026
	#КонецВставки
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеИБ.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Оборудование
		Или ДанныеИБ.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.ПродажаТоваровСоСкладаКомиссионера Тогда
		ПолученныеДанные.ВидОперации = ДанныеИБ.ВидОперации;
	КонецЕсли; 
	
	// Сохраняем патент, если он не заполнен в полученных данных
	Если Не ЗначениеЗаполнено(ПолученныеДанные.Патент) И ЗначениеЗаполнено(ДанныеИБ.Патент) Тогда
		ПолученныеДанные.Патент = ДанныеИБ.Патент;
	КонецЕсли;
	
	ОбработатьПризнакУПДПередЗаписью(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена);
	
	ОбнулениеСчетовУчетаРасчетовВДанныхИБ(ПолученныеДанные, ДанныеИБ);
	
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	// Восстанавливаем "затертые" данные
	//Товары
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("ЕдиницаИзмерения");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("Сумма");
	МассивКлючевыхПолей.Добавить("Цена");
	МассивКлючевыхПолей.Добавить("СтавкаНДС");
	МассивКлючевыхПолей.Добавить("СуммаНДС");
	МассивКлючевыхПолей.Добавить("НомерГТД");
	МассивКлючевыхПолей.Добавить("СтранаПроисхождения");
	МассивКлючевыхПолей.Добавить("ПрослеживаемыйТовар");
	
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ПолученныеДанные.Товары,
		ДанныеИБ.Товары,
		МассивКлючевыхПолей,
		"Коэффициент,СчетУчета,СчетУчетаНДСПоРеализации,СчетРасходов,ПереданныеСчетУчета,СчетДоходов,Субконто,КодТНВЭД,СчетНаОплатуПокупателю,СчетАкциза,СубконтоАкцизы");
	ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
	ДанныеИБ.СведенияПрослеживаемости.Загрузить(ПолученныеДанные.СведенияПрослеживаемости.Выгрузить());
	
	//Тара
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("Сумма");
	МассивКлючевыхПолей.Добавить("Цена");
	
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ПолученныеДанные.ВозвратнаяТара,
		ДанныеИБ.ВозвратнаяТара,
		МассивКлючевыхПолей,
		"СчетУчета,СчетНаОплатуПокупателю");
	ДанныеИБ.ВозвратнаяТара.Загрузить(ПолученныеДанные.ВозвратнаяТара.Выгрузить());
	
	//Услуги
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("Содержание");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("Сумма");
	МассивКлючевыхПолей.Добавить("Цена");
	МассивКлючевыхПолей.Добавить("СтавкаНДС");
	МассивКлючевыхПолей.Добавить("СуммаНДС");
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ПолученныеДанные.Услуги,
		ДанныеИБ.Услуги,
		МассивКлючевыхПолей,
		"СчетУчетаНДСПоРеализации,СчетРасходов,СчетДоходов,Субконто,СчетНаОплатуПокупателю");
	ДанныеИБ.Услуги.Загрузить(ПолученныеДанные.Услуги.Выгрузить());
	
	//АгентскиеУслуги
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("Содержание");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("Сумма");
	МассивКлючевыхПолей.Добавить("Цена");
	МассивКлючевыхПолей.Добавить("СтавкаНДС");
	МассивКлючевыхПолей.Добавить("СуммаНДС");
	МассивКлючевыхПолей.Добавить("Контрагент");
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ПолученныеДанные.АгентскиеУслуги,
		ДанныеИБ.АгентскиеУслуги,
		МассивКлючевыхПолей,
		"ДоговорКонтрагента,СчетРасчетов,СчетНаОплатуПокупателю");
	ДанныеИБ.АгентскиеУслуги.Загрузить(ПолученныеДанные.АгентскиеУслуги.Выгрузить());
	
	//Штрихкоды упаковок
	#Удаление
	ДанныеИБ.ШтрихкодыУпаковок.Загрузить(ПолученныеДанные.ШтрихкодыУпаковок.Выгрузить());
	#КонецУдаления
	#Вставка
	//++ #Б7868 смарт: не затирать коды маркировки, если в сообщении обмена ТЧ пустая.
	Если ПолученныеДанные.ШтрихкодыУпаковок.Количество() > 0 Тогда
		ДанныеИБ.ШтрихкодыУпаковок.Загрузить(ПолученныеДанные.ШтрихкодыУпаковок.Выгрузить());
	КонецЕсли;
	#КонецВставки
	
	// Зачет авансов
	ДанныеИБ.ЗачетАвансов.Загрузить(ПолученныеДанные.ЗачетАвансов.Выгрузить());
	         
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КомплектПечатныхДокументовПодписанПолучен") Тогда
		ДанныеИБ.ДополнительныеСвойства.Вставить("КомплектПечатныхДокументовПодписанПолучен", ПолученныеДанные.ДополнительныеСвойства.КомплектПечатныхДокументовПодписанПолучен);
	КонецЕсли;
	         
	ПолученныеДанные = Неопределено;
	
	УстановитьОтменуПроведенияДляРучнойКорректировки(ДанныеИБ);
	
	#Вставка
	// Смарт Фролов+ по заявке № 251 "Головное подразделение"
	//++ #Б1516 смарт: Шляпников 29.11.2024 / Синхронизация УТ-БП. Замена Обособленных подразделений
	смартЗаполнитьГоловноеПодразделение(ДанныеИБ);
	//-- #Б1516 смарт: Шляпников 29.11.2024
	// Смарт Фролов+ Убрать адрес доставки, что бы при печати УПД подставлялся Юридической адрес. 
	ДанныеИБ.АдресДоставки = "";
	// Фролов-
	#КонецВставки
	
КонецПроцедуры

&ИзменениеИКонтроль("УстановитьДляНовогоДокументаРеализацииПризнакУПД")
Процедура смарт_УстановитьДляНовогоДокументаРеализацииПризнакУПД(Объект)
	Если Не ЗначениеЗаполнено(Объект.ДоговорКонтрагента)
		Или Не ЭтоНовыйОбъект(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДополнительныеСвойства.Свойство("ПризнакУПДУстановленИзXDTO")
		И Объект.ДополнительныеСвойства.ПризнакУПДУстановленИзXDTO = Истина Тогда
		// Признак передан из сообщения обмена, так что устанавливать значение по умолчанию не требуется.
		Возврат;
	КонецЕсли;
	
	#Удаление //++#1890 смарт: Лопато 08.07.2024 //Переключатель УПД в Реализации
	ПараметрыДоговора = РаботаСДоговорамиКонтрагентовБП.ПараметрыДоговора(Объект.ДоговорКонтрагента);
	Объект.ЭтоУниверсальныйДокумент = ПараметрыДоговора.ЭтоУниверсальныйДокумент;
	#КонецУдаления
	
	#Вставка
	//++#1890 смарт: Лопато 08.07.2024 //Переключатель УПД в Реализации  
	Объект.ЭтоУниверсальныйДокумент = Истина;
	//--#1890 смарт: Лопато 08.07.2024
	#КонецВставки
	
КонецПроцедуры
#КонецОбласти

