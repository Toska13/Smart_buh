&После("ПКО_ПТиУ_ПоступлениеДопРасходов_ПередЗаписьюПолученныхДанных")
Процедура смартРасш_ПКО_ПТиУ_ПоступлениеДопРасходов_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	
	//перенос суммы доп. расходов и суммы НДС из ТЧ Товары в шапку документа
	Если ДанныеИБ <> Неопределено тогда
		//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 07.09.2021 18:03:49
		ДанныеИБ.Дата=НачалоДня(ДанныеИБ.Дата)+36000;
		//Смарт }Подкин Алексей Иванович 07.09.2021 18:03:49
		ДанныеИБ.Сумма = 0;
		ДанныеИБ.СуммаНДС = 0;
		Для каждого стр из ДанныеИБ.Товары цикл
			ДанныеИБ.Сумма = ДанныеИБ.Сумма + стр.Сумма;
			ДанныеИБ.СуммаНДС = ДанныеИБ.СуммаНДС + стр.СуммаНДС;
			
			стр.Сумма = 0;
			стр.СуммаНДС = 0;
		КонецЦикла;
	КонецЕсли;
	
	//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 02.07.2021 11:07:52
	Если ПолученныеДанные <> Неопределено тогда
		//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 07.09.2021 18:03:37
		ПолученныеДанные.Дата=НачалоДня(ПолученныеДанные.Дата)+36000;
		//Смарт }Подкин Алексей Иванович 07.09.2021 18:03:37
		ПолученныеДанные.Сумма = 0;
		ПолученныеДанные.СуммаНДС = 0;
		Для каждого стр из ПолученныеДанные.Товары цикл
			ПолученныеДанные.Сумма = ПолученныеДанные.Сумма + стр.Сумма;
			ПолученныеДанные.СуммаНДС = ПолученныеДанные.СуммаНДС + стр.СуммаНДС;
			
			стр.Сумма = 0;
			стр.СуммаНДС = 0;
		КонецЦикла;
	КонецЕсли;
	//Смарт }Подкин Алексей Иванович 02.07.2021 11:07:52

КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Документ_ПБДСПоПлатежнымКартам_Получение_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Документ_ПБДСПоПлатежнымКартам_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ЗапомнитьПрефиксДокумента(ПолученныеДанные, КомпонентыОбмена);
	
	ПолученныеДанные.СуммаУслуг = ПолученныеДанные.РасшифровкаПлатежа.Итог("СуммаУслуг");
	
	// Счет учета расчетов с контрагентом.
	ЗаполнитьСчетРасчетовВПолученныхДанных(ПолученныеДанные, ДанныеИБ);
	
	ЗаполнитьДоговорЭквайрингаВРасшифровкеПлатежа(КомпонентыОбмена, ПолученныеДанные);
	   
	Для Каждого СтрокаРасшифровки Из ПолученныеДанные.РасшифровкаПлатежа Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаРасшифровки.ДоговорКонтрагента) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПолученныеДанные.ДоговорКонтрагента) Тогда
			ПолученныеДанные.ДоговорКонтрагента = СтрокаРасшифровки.ДоговорКонтрагента;
		КонецЕсли;
		
		КомпонентыОбмена.ПараметрыКонвертации.ДоговорыЭквайрингаИзПоступленияНаРС.Вставить(СтрокаРасшифровки.ДоговорКонтрагента, Истина);   
		
	КонецЦикла;
	   
	ЗаписываемыйОбъект = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	УстановитьАналитикуСчетаВОбъекте(КомпонентыОбмена, ЗаписываемыйОбъект, ПолученныеДанные.ДополнительныеСвойства, ПолученныеДанные.СчетУчетаРасчетовСКонтрагентом, "СубконтоКт");
	
	СоответствиеСубконто = Новый Соответствие();
	СоответствиеСубконто.Вставить("ПрочиеДоходыИРасходы", ПолученныеДанные.СубконтоКт1);
	
	#Вставка
	//смартКаратеев ++
	//Подставляем договор контрагента по умолчанию
	//Подставляем комиссию банка
	
	Если ПолученныеДанные.СуммаУслуг = 0 ИЛИ ПолученныеДанные.СуммаУслуг = Неопределено Тогда
		СуммаУслугИзНазначения = смартНайтиСуммуКомиссииПоОснованию(ПолученныеДанные.НазначениеПлатежа);
		ПолученныеДанные.СуммаУслуг = СуммаУслугИзНазначения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ОсновныеДоговорыКонтрагента.Договор КАК Договор
		|ИЗ
		|	РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
		|ГДЕ
		|	ОсновныеДоговорыКонтрагента.Организация = &Организация
		|	И ОсновныеДоговорыКонтрагента.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", ?(ДанныеИБ = Неопределено,ПолученныеДанные.Контрагент,ДанныеИБ.Контрагент));
	Запрос.УстановитьПараметр("Организация", ?(ДанныеИБ = Неопределено,ПолученныеДанные.Организация,ДанныеИБ.Организация));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
	//ИсходныйКод ++
		ДоговорЭквайринга = ДоговорЭквайринга(ПолученныеДанные.Организация, ПолученныеДанные.Контрагент, Перечисления.ТипыОплат.ПлатежнаяКарта);
		Для Каждого Расшифровка Из ПолученныеДанные.РасшифровкаПлатежа Цикл
			Если НЕ ЗначениеЗаполнено(Расшифровка.ДоговорКонтрагента) Тогда
				Расшифровка.ДоговорКонтрагента = ДоговорЭквайринга;
				Расшифровка.СуммаУслуг = Число(?(Расшифровка.СуммаУслуг = 0 ИЛИ Расшифровка.СуммаУслуг = Неопределено, СуммаУслугИзНазначения, 0)); //Каратеев +-
			КонецЕсли;
		КонецЦикла;
	//ИсходныйКод --
	Иначе
		Выборка = РезультатЗапроса.Выбрать();	
		Пока Выборка.Следующий() Цикл
			Для Каждого Расшифровка Из ПолученныеДанные.РасшифровкаПлатежа Цикл
				Если НЕ Расшифровка.ДоговорКонтрагента = Выборка.Договор Тогда
					Расшифровка.ДоговорКонтрагента = Выборка.Договор;
				КонецЕсли;
				Расшифровка.СуммаУслуг = Число(?(Расшифровка.СуммаУслуг = 0 ИЛИ Расшифровка.СуммаУслуг = Неопределено, СуммаУслугИзНазначения, 0));
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	//Каратеев --
	#КонецВставки
	
	ЗаполнитьСубконтоВПолученныхДанных(ПолученныеДанные, ДанныеИБ, "СубконтоКт", СоответствиеСубконто);
	
	УстановитьПризнакПроведенПриЗагрузке(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена.ПараметрыКонвертации);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
							ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
							
	УстановитьОтменуПроведенияДляРучнойКорректировки(ДанныеИБ);
	
	#Вставка
	// Смарт Фролов+ по заявке № 251 "Головное подразделение"
	смартЗаполнитьГоловноеПодразделение(?(ДанныеИБ=Неопределено,ПолученныеДанные,ДанныеИБ));
	// Фролов-
	#КонецВставки
	
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Документ_ОперацияПоПлатежнойКарте_Получение_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Документ_ОперацияПоПлатежнойКарте_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДобавитьПризнакЭтоНовый(ПолученныеДанные, ДанныеИБ);
	
	ЗапомнитьПрефиксДокумента(ПолученныеДанные, КомпонентыОбмена);
	УстановитьПризнакПроведенПриЗагрузке(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена.ПараметрыКонвертации);
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
							ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
	ЗаполнитьДанныеЭквайераОперацииПоПлатежнойКарты(КомпонентыОбмена, ПолученныеДанные, ДанныеИБ);
	
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	
	#Вставка
	//смартКаратеев ++
	//Подставляем договор контрагента по умолчанию. Сделано по заявке бухгалтерии.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ОсновныеДоговорыКонтрагента.Договор КАК Договор
		|ИЗ
		|	РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
		|ГДЕ
		|	ОсновныеДоговорыКонтрагента.Организация = &Организация
		|	И ОсновныеДоговорыКонтрагента.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", ?(ДанныеИБ = Неопределено,ПолученныеДанные.Эквайер,ДанныеИБ.Эквайер));
	Запрос.УстановитьПараметр("Организация", ?(ДанныеИБ = Неопределено,ПолученныеДанные.Организация,ДанныеИБ.Организация));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда	
		ДоговорЭквайринга = ДоговорЭквайринга(ПолученныеДанные.Организация, ПолученныеДанные.Эквайер, Перечисления.ТипыОплат.ПлатежнаяКарта); //смартКаратеев +- // Исходный код
	Иначе
		ДоговорЭквайринга = РезультатЗапроса.Выгрузить()[0].Договор;	
	КонецЕсли;
	//Каратеев --
	
	ДанныеДляЗаписиВИБ.ДоговорЭквайринга = ДоговорЭквайринга;
		
	// ВидОплаты.    
	//++ смарт:Подкин #1083 29.06.2022 12:00:42
	ВидОплатыСтр = ВидОплатыОрганизации(
	КомпонентыОбмена,
	ПолученныеДанные.Организация,
	Перечисления.ТипыОплат.ПлатежнаяКарта,
	ПолученныеДанные.Эквайер,
	ДоговорЭквайринга);
	Если ВидОплатыСтр.Свойство("ВидОплаты") Тогда
		ДанныеДляЗаписиВИБ.ВидОплаты = ВидОплатыСтр.ВидОплаты;	
	КонецЕсли;
	//-- смарт:Подкин #1083 29.06.2022 12:00:42
	#КонецВставки
	
	// СчетКасса.
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписиВИБ.СчетКасса) Тогда
		ДанныеДляЗаписиВИБ.СчетКасса = ПланыСчетов.Хозрасчетный.ПродажиПоПлатежнымКартам;
	КонецЕсли;
	
	#Вставка
	// Смарт Фролов+ по заявке № 251 "Головное подразделение"
	смартЗаполнитьГоловноеПодразделение(?(ДанныеИБ=Неопределено,ПолученныеДанные,ДанныеИБ));
	// Фролов-
	#КонецВставки
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДанныеИБ.СсылочныйНомер)
		И Не ЗначениеЗаполнено(ПолученныеДанные.СсылочныйНомер) Тогда
		ПолученныеДанные.СсылочныйНомер = ДанныеИБ.СсылочныйНомер;
	КонецЕсли;
	
	Если ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя Тогда
		Если ДанныеИБ.ВидОперации = Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаСчетаЧерезСБП
			Или ДанныеИБ.ВидОперации = Перечисления.ВидыОперацийОплатаПлатежнойКартой.ПлатежПоРеестру Тогда
			// Через обмен мы умеем получать только ОплатаПокупателя, если в данных другой вид операции - то сохраняем его.
			ПолученныеДанные.ВидОперации = ДанныеИБ.ВидОперации;
		КонецЕсли;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO.
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	// Восстанавливаем "затертые" данные.
	
	// РасшифровкаПлатежа.
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("ДоговорКонтрагента");
	МассивКлючевыхПолей.Добавить("СуммаПлатежа");
	МассивКлючевыхПолей.Добавить("СуммаВзаиморасчетов");
	МассивКлючевыхПолей.Добавить("КурсВзаиморасчетов");
	МассивКлючевыхПолей.Добавить("КратностьВзаиморасчетов");
	
	ВосстанавливаемыеПоля = "СчетУчетаРасчетовСКонтрагентом, СчетУчетаРасчетовПоАвансам";
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.3") Тогда
		ВосстанавливаемыеПоля = ВосстанавливаемыеПоля + ", Сделка, СтавкаНДС, СуммаНДС, СпособПогашенияЗадолженности, СчетНаОплату";
	КонецЕсли;
	
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ПолученныеДанные.РасшифровкаПлатежа,
		ДанныеИБ.РасшифровкаПлатежа,
		МассивКлючевыхПолей,
		ВосстанавливаемыеПоля);
	ДанныеИБ.РасшифровкаПлатежа.Загрузить(ПолученныеДанные.РасшифровкаПлатежа.Выгрузить());
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("РасшифровкаПлатежа") Тогда
		// Сохраним расшифровку платежа для заполнения поля Сделка в ПослеЗагрузкиВсехДанных
		ДанныеИБ.ДополнительныеСвойства.Вставить("РасшифровкаПлатежа",  ПолученныеДанные.ДополнительныеСвойства.РасшифровкаПлатежа);
	КонецЕсли;
	
	ПолученныеДанные = Неопределено;
	
	УстановитьОтменуПроведенияДляРучнойКорректировки(ДанныеИБ);
КонецПроцедуры

#Область Контрагент
&После("ПКО_Справочник_Контрагенты_Получение_ПриКонвертацииДанныхXDTO")
Процедура смарт_ПКО_Справочник_Контрагенты_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	//смартКаратеев ++
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
		
		ДопДанные = ДанныеXDTO.AdditionalInfo;
		
		Если ДопДанные.Свойство("ИсторияКПП") Тогда
			ПолученныеДанные.ИсторияКПП.Загрузить(ДопДанные.ИсторияКПП);
		КонецЕсли;
		
		//++ #1356 смарт: Лопато 21.11.2024 //Обмен УТ- БП. Все ИП прилетают в БП как физлицо.  
		Если ДопДанные.Свойство("ЮрФизЛицо") Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ЮрФизЛицо", ДопДанные.ЮрФизЛицо);
		КонецЕсли;
		//-- #1356 смарт: Лопато 21.11.2024
		
		//++ #Б4336 смарт: Шляпников 23.09.2025 / История изменения контрагентов по датам в 1С БП СМАРТ-Т
		Если ДопДанные.Свойство("ИсторияНаименований") Тогда
			ПолученныеДанные.ИсторияНаименований.Загрузить(ДопДанные.ИсторияНаименований);
		КонецЕсли;
		//-- #Б4336 смарт: Шляпников 23.09.2025
		
	КонецЕсли;
	//Каратеев --

КонецПроцедуры

&Вместо("ПКО_Справочник_Контрагенты_Получение_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Справочник_Контрагенты_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДобавитьПризнакЭтоНовый(ПолученныеДанные, ДанныеИБ);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
							ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	
	Если ДанныеИБ = Неопределено
		И НЕ ЗначениеЗаполнено(ПолученныеДанные.СтранаРегистрации) Тогда
		ПолученныеДанные.СтранаРегистрации = Справочники.СтраныМира.Россия;
	КонецЕсли;
	
	//++ #1356 смарт: Лопато 21.11.2024 //Обмен УТ- БП. Все ИП прилетают в БП как физлицо.  
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ЮрФизЛицо") Тогда
		
		ПолученныеДанные.ИндивидуальныйПредприниматель = 
			(ПолученныеДанные.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо
			 И ПолученныеДанные.ДополнительныеСвойства.ЮрФизЛицо = "Индивидуальный предприниматель");
		
	КонецЕсли;
	//-- #1356 смарт: Лопато 21.11.2024
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO.
	ЗаполнитьНеПустыеСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	
	// Виды контактной информации и дополнительные реквизиты, которые есть в данных ИБ
	// не удаляются, если этих значений нет в полученных данных.
	// Если значение есть - то оно обновляется.
	
	ЗаполнитьКонтактнуюИнформациюВДанныеИБ(ПолученныеДанные, ДанныеИБ);
	
	ЗаполнитьДополнительныеРеквизитыВДанныеИБ(ПолученныеДанные, ДанныеИБ);
	
	//смартКаратеев ++
	смартЗаполнитьИсториюКППВДанныеИБ(ПолученныеДанные, ДанныеИБ);
	//Каратеев --
	
	//++ #Б4336 смарт: Шляпников 23.09.2025 / История изменения контрагентов по датам в 1С БП СМАРТ-Т
	смартЗаполнитьИсториюНаименованийВДанныеИБ(ПолученныеДанные, ДанныеИБ);
	//-- #Б4336 смарт: Шляпников 23.09.2025
	
	//++ #1356 смарт: Лопато 21.11.2024 //Обмен УТ- БП. Все ИП прилетают в БП как физлицо.  
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ЮрФизЛицо") Тогда
		
		ДанныеИБ.ИндивидуальныйПредприниматель = 
			(ДанныеИБ.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо
			 И ПолученныеДанные.ДополнительныеСвойства.ЮрФизЛицо = "Индивидуальный предприниматель");
		
	КонецЕсли;
	//-- #1356 смарт: Лопато 21.11.2024
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры
#КонецОбласти

