	СчетУчета4101 = ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ТоварыНаСкладах");
	Для каждого стр из ПолученныеДанные.Товары цикл
		стр.СчетУчета = СчетУчета4101;
