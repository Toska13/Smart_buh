//++ смарт:КМД #3_3 461 05.03.2021
&После("ПОД_Документ_РеализацияТоваровУслуг_ПриОбработке")
Процедура смартРасш_ПОД_Документ_РеализацияТоваровУслуг_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		Если ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") И ДанныеXDTO.AdditionalInfo.Свойство("смартБезвозмезднаяПередача")
			И ДанныеXDTO.AdditionalInfo.смартБезвозмезднаяПередача = Истина тогда
			
			ИспользованиеПКО.Документ_ПередачаТоваров_БезПер_Получение = Истина;
			ИспользованиеПКО.Документ_РТиУБезПереходаПравСобственностиУслуги = Ложь;
			ИспользованиеПКО.Документ_РеализацияОтгруженныхТоваров_Получение = Ложь;
			ИспользованиеПКО.Документ_РеализацияТоваровУслуг = Ложь;
		Иначе
			ИспользованиеПКО.Документ_ПередачаТоваров_БезПер_Получение = Ложь;
		КонецЕсли;
	Иначе
		ИспользованиеПКО.Документ_ПередачаТоваров_БезПер_Получение = Ложь;
	КонецЕсли;
КонецПроцедуры

