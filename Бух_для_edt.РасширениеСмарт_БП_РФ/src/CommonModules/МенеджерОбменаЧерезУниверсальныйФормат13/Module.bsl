&После("ВыполнитьПроцедуруМодуляМенеджера")
Процедура смартРасш_ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры)
	Если ИмяПроцедуры = "ПКО_Документ_ПередачаТоваров_БезПер_Получение_ПриКонвертацииДанныхXDTO" Тогда 
		ПКО_Документ_ПередачаТоваров_БезПер_Получение_ПриКонвертацииДанныхXDTO(
			Параметры.ДанныеXDTO, Параметры.ПолученныеДанные, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "ПКО_Документ_ПередачаТоваров_БезПер_Получение_ПередЗаписьюПолученныхДанных" Тогда 
		ПКО_Документ_ПередачаТоваров_БезПер_Получение_ПередЗаписьюПолученныхДанных(
		Параметры.ПолученныеДанные, Параметры.ДанныеИБ, Параметры.КонвертацияСвойств, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "ОтложеннаяОбработка_ПередачаТоваровДоп" Тогда 
		ОтложеннаяОбработка_ПередачаТоваровДоп(
		Параметры.Объект, Параметры.КомпонентыОбмена.ПараметрыКонвертации, Параметры.ОбъектМодифицирован);
	КонецЕсли;
	
	//Смарт Подкин Алексей Иванович 320 15.03.2021 
	Если ИмяПроцедуры = "ПОД_Документ_КорректировкаДолга_ВЗ_Отправка_ПриОбработке" Тогда 
		ПОД_Документ_КорректировкаДолга_ВЗ_Отправка_ПриОбработке(
		Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "ПКО_Документ_КорректировкаДолга_ВЗ_ЗА_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Документ_КорректировкаДолга_ВЗ_ЗА_Отправка_ПриОтправкеДанных(
		Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли  ИмяПроцедуры = "ПКО_Документ_КорректировкаДолга_ВЗ_ПК_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Документ_КорректировкаДолга_ВЗ_ПК_Отправка_ПриОтправкеДанных(
		Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли  ИмяПроцедуры = "ПКО_Документ_КорректировкаДолга_ВЗ_ПЗ_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Документ_КорректировкаДолга_ВЗ_ПЗ_Отправка_ПриОтправкеДанных(
		Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли  ИмяПроцедуры = "ПКО_Документ_КорректировкаДолга_ВЗ_СЗ_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_Документ_КорректировкаДолга_ВЗ_СЗ_Отправка_ПриОтправкеДанных(
		Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	КонецЕсли;
	//Смарт Подкин Алексей Иванович 320 15.03.2021 
	
	//++ #Б5128 смарт: Шляпников 22.12.2025 / Маркировка радиоэлектронной продукции. Доработка справочника "Классификатор ТН ВЭД". 1С БП
	Если ИмяПроцедуры = "смарт_Справочник_КлассификаторТНВЭД_ЭлементСправочника_ПриОтправкеДанных" Тогда 
		смарт_Справочник_КлассификаторТНВЭД_ЭлементСправочника_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "смарт_Справочник_КлассификаторТНВЭД_ЭлементСправочника_ПередЗаписьюПолученныхДанных" Тогда 
		смарт_Справочник_КлассификаторТНВЭД_ЭлементСправочника_ПередЗаписьюПолученныхДанных(
			Параметры.ПолученныеДанные, Параметры.ДанныеИБ, Параметры.КонвертацияСвойств, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "смарт_Справочник_КлассификаторТНВЭД_ЭлементСправочника_ПриКонвертацииДанныхXDTO" Тогда 
		смарт_Справочник_КлассификаторТНВЭД_ЭлементСправочника_ПриКонвертацииДанныхXDTO(
			Параметры.ДанныеXDTO, Параметры.ПолученныеДанные, Параметры.КомпонентыОбмена);
	КонецЕсли;
	//-- #Б5128 смарт: Шляпников 22.12.2025
	
	
	//++ #6654  смарт: Тимофеева 19.05.2026 / Взаиморасчеты. Часть5. Взаимозачет между тремя юр лицами.
    Если ИмяПроцедуры = "ПОД_Документ_Операция_ВЗСложный_Отправка_ПриОбработке" Тогда 
		ПОД_Документ_Операция_ВЗСложный_Отправка_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "ПКО_Документ_Операция_ВЗСложный_Отправка_ПриОтправкеДанных" Тогда
		ПКО_Документ_Операция_ВЗСложный_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);	
	КонецЕсли;
	//-- #6654  смарт: Тимофеева 19.05.2026	
КонецПроцедуры

