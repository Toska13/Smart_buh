Функция смартПолучитьСсылкуНоМенеджеруОбъекта(ОбъектыМенеджер,УникальныйИдентификатор)	
	Для Каждого Менеджер Из ОбъектыМенеджер Цикл	
		СсылкаНаОбъект = Менеджер.ПолучитьСсылку(УникальныйИдентификатор);		
		Если СсылкаНаОбъект.ПолучитьОбъект() <> Неопределено Тогда	
			Возврат СсылкаНаОбъект;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат Неопределено;	
КонецФункции

//смартКаратеев ++
Функция смартНайтиСуммуКомиссииПоОснованию(Строка)
	
	Начало = СтрНайти(Строка,"Комиссия ")+9;
	Конец = СтрНайти(Строка,". ",,Начало);
	СуммаКомиссииСтрокой = смартСуммаБезЛишнихЗнаков(Сред(Строка,Начало,Конец-Начало));
	Попытка	
		СуммаКомиссии = Число(?(СуммаКомиссииСтрокой = "","0",СуммаКомиссииСтрокой));			
	Исключение
		СуммаКомиссии = 0;
	КонецПопытки; 
	
	Возврат СуммаКомиссии;
	
КонецФункции

//смартКаратеев ++
Функция смартСуммаБезЛишнихЗнаков(ВхСтрока)
	
	ВыхСтрока="";	
	Для Знак = 1 По СтрДлина(ВхСтрока) Цикл
		Символ = Сред(ВхСтрока,Знак,1);		
		Если (Символ>="0" И Символ<="9") ИЛИ Символ = "." Тогда
			ВыхСтрока=ВыхСтрока+Символ;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ВыхСтрока;
	
КонецФункции

//смартКаратеев ++
Процедура смартЗаполнитьИсториюКППВДанныеИБ(ПолученныеДанные, ДанныеИБ)
	
	ИсторияКППИзПолученныхДанных = ПолученныеДанные.ИсторияКПП.Выгрузить();
	ИсторияКППИзПолученныхДанных.Свернуть("КПП", "");
	
	Для Каждого ЗаписьКПП Из ИсторияКППИзПолученныхДанных Цикл
		Если ЗначениеЗаполнено(ЗаписьКПП.КПП) Тогда
			
			СтруктураОтбора = Новый Структура("КПП", ЗаписьКПП.КПП);
			
			СтрокиДляУдаления = ДанныеИБ.ИсторияКПП.НайтиСтроки(СтруктураОтбора);
			Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
				ДанныеИБ.ИсторияКПП.Удалить(СтрокаДляУдаления);
			КонецЦикла;
			
			СтрокиДляКопирования = ПолученныеДанные.ИсторияКПП.НайтиСтроки(СтруктураОтбора);
			Для Каждого СтрокаДляКопирования Из СтрокиДляКопирования Цикл
				ЗаполнитьЗначенияСвойств(ДанныеИБ.ИсторияКПП.Добавить(), СтрокаДляКопирования);
			КонецЦикла;
		
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

