#Область Документ_ЗаказКлиента_Получение

//++ #Б-1828 смарт: Лопато 09.01.2025 //Проверка синхронизации УТ_РФ - БП-СМАРТ
&ИзменениеИКонтроль("ПКО_Документ_ЗаказКлиента_Получение_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Документ_ЗаказКлиента_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДобавитьПризнакЭтоНовый(ПолученныеДанные, ДанныеИБ);
	
	ЗапомнитьПрефиксДокумента(ПолученныеДанные, КомпонентыОбмена);
	ЗаполнитьКурсИКратностьВзаиморасчетов(ПолученныеДанные);
	
	ПолученныеДанные.Склад = СкладДляЗагрузки(ПолученныеДанные.Склад, КомпонентыОбмена.ПараметрыКонвертации);
	
	УстановитьПризнакПроведенПриЗагрузке(ПолученныеДанные, ДанныеИБ, КомпонентыОбмена.ПараметрыКонвертации);
	
	ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
							ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
											
	ПолученныеДанные.ДокументБезНДС = ДокументБезНДС(ПолученныеДанные, ПолученныеДанные.Организация, ПолученныеДанные.Дата, "Товары");
	
	#Вставка
	//++ #Б-1828 смарт: Лопато 09.01.2025 //Проверка синхронизации УТ_РФ - БП-СМАРТ
	// Смарт Фролов+ по заявке № 251 "Головное подразделение"
	Данные = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
	//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 251 07.04.2021 
	Если ДанныеИБ <> Неопределено И ДанныеИБ.Метаданные().Реквизиты.Найти("ПодразделениеОрганизации") <> Неопределено 
		И ЗначениеЗаполнено(ДанныеИБ.ПодразделениеОрганизации) Тогда
		ПолученныеДанные.ПодразделениеОрганизации = ДанныеИБ.ПодразделениеОрганизации;
	Иначе
		смартЗаполнитьГоловноеПодразделение(ПолученныеДанные);
	КонецЕсли;
	//Смарт }Подкин Алексей Иванович 251 07.04.2021
	// Смарт Фролов+ Убрать адрес доставки, что бы при печати УПД подставлялся Юридический адрес.
	Данные.АдресДоставки = "";
	Если Не ПолученныеДанные = Неопределено Тогда 
		ПолученныеДанные.АдресДоставки = "";
	КонецЕсли;	
	// Фролов-
	//-- #Б-1828 смарт: Лопато 09.01.2025
	
	//++ #Б7862 смарт: Шляпников 18.08.2026 / Синхронизация Услуг в БП Смарт. Единица измерения.
	Для каждого стрУслуга Из ПолученныеДанные.Товары Цикл
		
		Если стрУслуга.Номенклатура.Услуга Тогда
			
			стрУслуга.Количество = 0;
			стрУслуга.Цена = стрУслуга.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
	//-- #Б7862 смарт: Шляпников 18.08.2026
	#КонецВставки
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеИБ.СпособДоставки) И Не ЗначениеЗаполнено(ПолученныеДанные.СпособДоставки) Тогда
		ПолученныеДанные.СпособДоставки = ДанныеИБ.СпособДоставки;
	КонецЕсли;
	
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	//Товары
	МассивКлючевыхПолей = Новый Массив;
	МассивКлючевыхПолей.Добавить("Номенклатура");
	МассивКлючевыхПолей.Добавить("Содержание");
	МассивКлючевыхПолей.Добавить("Количество");
	МассивКлючевыхПолей.Добавить("Сумма");
	МассивКлючевыхПолей.Добавить("Цена");
	МассивКлючевыхПолей.Добавить("СтавкаНДС");
	МассивКлючевыхПолей.Добавить("СуммаНДС");
	
	ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ПолученныеДанные.Товары,
		ДанныеИБ.Товары,
		МассивКлючевыхПолей,
		"ПроцентСкидки,СуммаСкидки,КлючКалькуляцииРасходов,ВидЛьготыПоТуристическомуНалогу,ИдентификаторСтроки,ИдентификаторРодительскойСтроки");
	ДанныеИБ.Товары.Загрузить(ПолученныеДанные.Товары.Выгрузить());
	
	//Тара
	ДанныеИБ.ВозвратнаяТара.Загрузить(ПолученныеДанные.ВозвратнаяТара.Выгрузить());
	
	#Вставка
	//++ #Б7862 смарт: Шляпников 18.08.2026 / Синхронизация Услуг в БП Смарт. Единица измерения.
	Для каждого стрУслуга Из ДанныеИБ.Товары Цикл
		
		Если стрУслуга.Номенклатура.Услуга Тогда
			
			стрУслуга.Количество = 0;
			стрУслуга.Цена = стрУслуга.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
	//-- #Б7862 смарт: Шляпников 18.08.2026
	#КонецВставки
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры

#КонецОбласти

