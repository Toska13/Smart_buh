//++ смарт:КМД #3_3 461 05.03.2021 //функционал «Безвозмездная передача»
Процедура ОтложеннаяОбработка_ПередачаТоваровДоп(Объект, ПараметрыКонвертации, ОбъектМодифицирован)
	Если НЕ ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		// Устанавливаем основной договор, если он не найден.
		Объект.ДоговорКонтрагента = ОсновнойДоговорКонтрагента(Объект, Объект.Организация, Объект.Контрагент, Объект.ВалютаДокумента);
	КонецЕсли;
	
	// Заполняем счета учета
	
	//не работает с этим документом
	//ЗаполнитьСчетаУчета(Объект);
	
	Объект.СчетЗатрат = ПланыСчетов.Хозрасчетный.ПрочиеРасходы;  //91.02
	Объект.СчетУчетаНДС = ПланыСчетов.Хозрасчетный.ПрочиеРасходы; //91.02
	СтатьяРасходов = Справочники.ПрочиеДоходыИРасходы.ПредопределенныйЭлемент("РасходыПоБезвозмезднойПередаче");
	
	Объект.Субконто1 = СтатьяРасходов;
	Объект.СубконтоНДС1 = СтатьяРасходов;
	
	//заполнение счетов учета номенклатуры
	Для каждого стр из Объект.Товары цикл
		Если НЕ ЗначениеЗаполнено(стр.СчетУчета) тогда
			СтруктураСчетУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(Объект.Организация,
				стр.Номенклатура, Объект.Склад, Объект.Дата);
			стр.СчетУчета = СтруктураСчетУчета.СчетУчета;
		КонецЕсли;
	КонецЦикла;
	
	//ЗаполнитьДеятельностьНаПатентеТорговомСборе(Объект);
	
