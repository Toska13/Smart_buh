#Область ДоработкиСмарт
	
// Яшников 20180322 +++
Функция смартПолучитьДоверенностьОтветственногоЛица(Организация, ФизическоеЛицо, Должность)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОснованияПраваПодписи.Организация КАК Организация,
		|	ОснованияПраваПодписи.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОснованияПраваПодписи.Представление КАК Представление
		|ИЗ
		|	Справочник.ОснованияПраваПодписи КАК ОснованияПраваПодписи
		|ГДЕ
		|	ОснованияПраваПодписи.ФизическоеЛицо = &ФизическоеЛицо
		|	И ОснованияПраваПодписи.Организация = &Организация
		|	И ОснованияПраваПодписи.Должность <> &Должность
		|	И НЕ ОснованияПраваПодписи.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОснованияПраваПодписи.ДатаНачала УБЫВ";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Должность", Должность);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаРезультата = Запрос.Выполнить().Выбрать();
	
	СтруктураВозврата = Новый Структура;
	
	Пока ВыборкаРезультата.Следующий() Цикл
		СтруктураВозврата.Вставить("Доверенность", ВыборкаРезультата.Представление); 
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти