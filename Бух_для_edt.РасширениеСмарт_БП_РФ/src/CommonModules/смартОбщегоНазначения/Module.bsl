//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
Функция ПолучитьFTPСоединение(Склад) Экспорт

	АдресFTP  = Склад.АтлантFTPАдрес;
	ЛогинFTP  = Склад.АтлантFTPЛогин;
	ПарольFTP = Склад.АтлантFTPПароль;
	
	Если НЕ (ЗначениеЗаполнено(АдресFTP) И ЗначениеЗаполнено(ЛогинFTP) И ЗначениеЗаполнено(ПарольFTP)) Тогда
		Возврат	Неопределено;
	КонецЕсли;	
			 
    Попытка
		FTPСоединение = Новый FTPСоединение(АдресFTP, , ЛогинFTP, ПарольFTP, , Истина, 50);
	Исключение
		Возврат	Неопределено;
	КонецПопытки;
	
	Возврат FTPСоединение;
	
КонецФункции

//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
Функция ЗаписатьФайлВКаталог(FTPСоединениеАтлант, Каталог, ИмяФайлаЛокальныйПуть, ИмяФайла, ТестовыйРежим = Ложь) Экспорт

	//in - запросы на приемку, мы размещаем
	//ex_in - ответы по приемкам, мы читаем
	//out - запросы на отгрузку, мы размещаем
	//ex_out - ответы по отгрузкам, мы читаем
	//md - справочник товаров, мы размещаем
	
	//Каталоги для тестирования имеют постфикс "1".

	ПутьКаталога = "/" + Каталог + ?(ТестовыйРежим, "1", "");

	Попытка
	
		FTPСоединениеАтлант.УстановитьТекущийКаталог(ПутьКаталога);

		FTPСоединениеАтлант.Записать(ИмяФайлаЛокальныйПуть, ИмяФайла);	

		Результат = Истина;
		
	Исключение

		ЗаписьЖурналаРегистрации("Обмен со складом Атлант", УровеньЖурналаРегистрации.Ошибка, , ,
								 "Не удалось записать файл " + ИмяФайла + " в каталог " + ПутьКаталога);
		
		Результат = Ложь;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
Процедура ОтправитьЗаявкуВАтлантСервер(ИмяФайла, ДвоичныеДанные, Склад) Экспорт
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Соединение = ПолучитьFTPСоединение(Склад);
	Если Соединение = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось установить FTP соединение с сервером Атлант");
		Возврат;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	Если НЕ	ЗаписатьФайлВКаталог(Соединение, "out", ИмяВременногоФайла, ИмяФайла) Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не удалось установить записать файл %1 на FTP", ИмяФайла));
	КонецЕсли;
	
	УдалитьФайлы(ИмяВременногоФайла);
		
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон("На FTP Атлант выгружен файл %1", ИмяФайла));
	
КонецПроцедуры

