		ТабДок.Область("R" + (НомерСтроки + 4) + "C" + НомерКолонкиФИОРук).Текст = ""; // ФИО кладовщик
		ТабДок.Область("R" + (НомерСтроки + 2) + "C" + НомерКолонкиФИОРук).Текст = ""; // ФИО бух
		
