// ДокСсылка - РеализацияТоваровУслуг
Функция СформироватьТабличныеДокументыПоДаннымУТ(ДокСсылка) Экспорт
	
	СтруктураВозврат = Новый Структура;
	
	ПроксиWS = Неопределено;
	
	//++ смарт:ММ 572 22.07.2021
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаМашину", 	Неопределено);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаМашину", "");
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаОтгрузку", Неопределено);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаОтгрузку", "");
	СтруктураВозврат.Вставить("НазваниеАвто", "");
	СтруктураВозврат.Вставить("НомерАвто", "");
	
	СпособОтгрузкиСоСкладаАдмирал = Ложь;
	ВЗаказеСкладАдмирал = Ложь;
	НазваниеАвто = "";
	НомерАвто = "";
	ПроверитьЗаказКлиента(ПроксиWS, ДокСсылка, СпособОтгрузкиСоСкладаАдмирал, ВЗаказеСкладАдмирал, НазваниеАвто, НомерАвто);
	
	//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
	Если ВЗаказеСкладАдмирал = "Атлант" Тогда
		ВЗаказеСкладАдмирал = Истина;
		ЭтоАтлант = Истина;
	Иначе
		ЭтоАтлант = Ложь;
	КонецЕсли;
	//-- #Б3572 смарт: Шляпников 17.06.2025

	СтруктураВозврат.Вставить("СпособОтгрузкиСоСкладаАдмирал", СпособОтгрузкиСоСкладаАдмирал);
	СтруктураВозврат.Вставить("ВЗаказеСкладАдмирал", ВЗаказеСкладАдмирал);
	СтруктураВозврат.Вставить("НазваниеАвто", НазваниеАвто);
	СтруктураВозврат.Вставить("НомерАвто", НомерАвто);
	СтруктураВозврат.Вставить("ЭтоАтлант", ЭтоАтлант);

	//++ смарт:ММ 606 12.09.2021
	СтруктураВозврат.Вставить("ДвоичныеДанныеXML", Неопределено);
	//-- смарт:ММ 12.09.2021
	
	Если НЕ ВЗаказеСкладАдмирал Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Если СпособОтгрузкиСоСкладаАдмирал Тогда
	//-- смарт:ММ 22.07.2021
	
	ИмяФайлаЗаявкаНаМашину = "";
	//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
	Если ЭтоАтлант Тогда
		ТабДокЗаявкаНаМашину = Неопределено;
	Иначе
		ТабДокЗаявкаНаМашину = СформироватьТабличныйДокументЗаявкаНаМашину(ДокСсылка, ИмяФайлаЗаявкаНаМашину, "xlsx", ПроксиWS);
	КонецЕсли;
	//-- #Б3572 смарт: Шляпников 17.06.2025
	
	//++ смарт:ММ 572 22.07.2021
	Иначе
		ИмяФайлаЗаявкаНаМашину = "";
		ТабДокЗаявкаНаМашину = Неопределено;
	КонецЕсли;
	//-- смарт:ММ 22.07.2021

	ИмяФайлаЗаявкаНаОтгрузку = "";
	//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
	Если ЭтоАтлант Тогда
		ТабДокЗаявкаНаОтгрузку = СформироватьТабличныйДокументЗаявкаНаОтгрузкуАтлант(ДокСсылка, ИмяФайлаЗаявкаНаОтгрузку, "xls", ПроксиWS);
	Иначе
		ТабДокЗаявкаНаОтгрузку = СформироватьТабличныйДокументЗаявкаНаОтгрузку(ДокСсылка, ИмяФайлаЗаявкаНаОтгрузку, "xlsx", ПроксиWS);
	КонецЕсли;
	//-- #Б3572 смарт: Шляпников 17.06.2025
	
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаМашину", 	ТабДокЗаявкаНаМашину);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаМашину", ИмяФайлаЗаявкаНаМашину);
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаОтгрузку", ТабДокЗаявкаНаОтгрузку);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаОтгрузку", ИмяФайлаЗаявкаНаОтгрузку);
	
	//++ смарт:ММ 606 12.09.2021
	//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
	ИмяФайлаXML = "";
	Если ЭтоАтлант Тогда
		ДвоичныеДанныеXML = СформироватьXMLПоЗаявкаНаОтгрузкуАтлант(ДокСсылка, ИмяФайлаXML, ПроксиWS);
	Иначе
		ДвоичныеДанныеXML = СформироватьXMLПоЗаявкаНаОтгрузку(ДокСсылка, "ПакетДанныхПоЗаявкамНаОтгрузку.XML", ПроксиWS);
	КонецЕсли;
	СтруктураВозврат.Вставить("ИмяФайлаXML", ИмяФайлаXML);
	//-- #Б3572 смарт: Шляпников 17.06.2025
	СтруктураВозврат.Вставить("ДвоичныеДанныеXML", ДвоичныеДанныеXML);
	//-- смарт:ММ 12.09.2021
	
	ПроксиWS = Неопределено;
	
	Возврат СтруктураВозврат;
	
КонецФункции //-- смарт:ММ 08.07.2021

//++ смарт:ММ 572 22.07.2021
Процедура ПроверитьЗаказКлиента(ПроксиWS, ДокСсылка, СпособОтгрузкиСоСкладаАдмирал, ВЗаказеСкладАдмирал, НазваниеАвто, НомерАвто)
	
	// Подключение к УТ через веб-сервис
	Если ПроксиWS = Неопределено Тогда
		ПроксиWS = ПодключениеК_УТ();	
	КонецЕсли;
	
	Если ПроксиWS = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("Номер", ДокСсылка.Номер);
	ПараметрыЗапроса.Вставить("Дата", ДокСсылка.Дата);
	
	Сериализатор = Новый СериализаторXDTO(ПроксиWS.ФабрикаXDTO);
	ПараметрыЗапросаXDTO = Сериализатор.ЗаписатьXDTO(ПараметрыЗапроса);
	
	ЗапросТекст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.ЗаказКлиента КАК Заказ,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА РеализацияТоваровУслуг.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|					И РеализацияТоваровУслуг.Склад.смартАвтоматическиФормироватьДокументы
	|				ТОГДА ИСТИНА
	|			КОГДА РеализацияТоваровУслугТовары.Склад.смартАвтоматическиФормироватьДокументы
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ВЗаказеСкладАдмирал,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА РеализацияТоваровУслуг.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПУстаяСсылка)
	|					И РеализацияТоваровУслуг.Склад.смартАвтоматическиФормироватьДокументы И РеализацияТоваровУслуг.Склад.смартНастройкаОбменомСАтлант <> ЗНАЧЕНИЕ(ПланОбмена.смартОбменСоСкладомАтлант.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			КОГДА РеализацияТоваровУслугТовары.Склад.смартАвтоматическиФормироватьДокументы И РеализацияТоваровУслугТовары.Склад.смартНастройкаОбменомСАтлант <> ЗНАЧЕНИЕ(ПланОбмена.смартОбменСоСкладомАтлант.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ВЗаказеСкладАтлант
	|ПОМЕСТИТЬ ВТ_Заказ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО РеализацияТоваровУслуг.Ссылка = РеализацияТоваровУслугТовары.Ссылка
	|ГДЕ
	|	РеализацияТоваровУслуг.Номер = &Номер
	|	И РеализацияТоваровУслуг.Дата = &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслуг.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК СпособОтгрузкиСоСкладаАдмирал,
	|	МАКСИМУМ(ВТ_Заказ.ВЗаказеСкладАдмирал) КАК ВЗаказеСкладАдмирал,
	|	МАКСИМУМ(ВТ_Заказ.ВЗаказеСкладАтлант) КАК ВЗаказеСкладАтлант,
	|	МАКСИМУМ(ЗаказКлиента.смартВидТранспорта) КАК смартВидТранспорта,
	|	МАКСИМУМ(ЗаказКлиента.смартНомерМашины) КАК НомерМашины,
	|	МАКСИМУМ(ЗаказКлиента.смартНомерПрицепа) КАК смартНомерПрицепа
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказ КАК ВТ_Заказ
	|		ПО ЗаказКлиента.Ссылка = ВТ_Заказ.Заказ";
	
	ТаблицаХОПрокси = ПроксиWS.ПолучитьТаблицуРезультатаЗапроса(ЗапросТекст, ПараметрыЗапросаXDTO);	
	ТЗ_УТ1 = Сериализатор.ПрочитатьXDTO(ТаблицаХОПрокси);
	
	Для Каждого ТекСтрока Из ТЗ_УТ1 Цикл
		
		СпособОтгрузкиСоСкладаАдмирал = ТекСтрока.СпособОтгрузкиСоСкладаАдмирал;
		ВЗаказеСкладАдмирал = ТекСтрока.ВЗаказеСкладАдмирал;
		НазваниеАвто = ТекСтрока.смартВидТранспорта;
		НомерАвто = СтрШаблон("%1 %2", СокрЛП(ТекСтрока.НомерМашины), ТекСтрока.смартНомерПрицепа);
		
		//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
		Если ТекСтрока.ВЗаказеСкладАтлант Тогда
			ВЗаказеСкладАдмирал = "Атлант";
		КонецЕсли;
		//-- #Б3572 смарт: Шляпников 17.06.2025
		
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 22.07.2021

//++ смарт:ММ 572 14.07.2021
Функция СформироватьТабличныйДокументТранспортнаяНакладная(ДокСсылка, ИмяФайла = "", НазваниеАвто = "", НомерАвто = "") Экспорт
	
	//// ++ 26.08.2021
	//Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокСсылка.Номер, Истина, Истина);
	//// --
    
     //Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 01.12.2021 11:39:35 задача 715
    НомерЗаказа = "";
    Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокСсылка,"СчетНаОплатуПокупателю") И СтрНайти(ДокСсылка.СчетНаОплатуПокупателю.Номер,"ОПЦБ-")>0 Тогда
        //НомерЗаказа = ДокСсылка.ДоговорКонтрагента.Номер;
        НомерЗаказа = ДокСсылка.СчетНаОплатуПокупателю.Номер;
    КонецЕсли;
    //Смарт }Подкин Алексей Иванович 01.12.2021 11:39:35
	
	//++ #3984 смарт: Шляпников 06.08.2025 / Интеграция с WMS. Атлант. Отгрузка. Дополнение.
	НомерТТН = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокСсылка.Номер, Истина, Истина);
	
    //Смарт {[*](фрагмент ИЗМЕНЕН), Подкин Алексей Иванович 01.12.2021 12:13:53 задача 715
    ИмяФайла = "Транспортная накладная № " + НомерТТН + " от " + Формат(ДокСсылка.Дата, "ДФ='dd MMMM yyyy ""г""'") +?(НомерЗаказа = "",""," (по сч. "+НомерЗаказа+")")+ ".pdf";
    //Смарт }Подкин Алексей Иванович 01.12.2021 12:13:53
	//-- #3984 смарт: Шляпников 06.08.2025
    
    МассивОбъектов = Новый Массив;
    МассивОбъектов.Добавить(ДокСсылка);
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечати.Добавить(ДокСсылка, "Документ_1");
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	ПараметрыВывода = Новый Структура;
	//++ смарт:ММ 663 02.10.2021 
	ПараметрыВывода.Вставить("смартЭтоСкладАдмирал", Истина);
	//-- смарт:ММ 02.10.2021
	
	ВременнаяКоллекцияДляОднойПечатнойФормы = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм("ТранспортнаяНакладная");

	Обработки.ПечатьТранспортнойНакладной.Печать(МассивОбъектов, ПараметрыПечати, ВременнаяКоллекцияДляОднойПечатнойФормы, 
						ОбъектыПечати, ПараметрыВывода);

	ТабДок = Неопределено;
	
	Если ВременнаяКоллекцияДляОднойПечатнойФормы.Количество() > 0 Тогда
		ТабДок = ВременнаяКоллекцияДляОднойПечатнойФормы[0].ТабличныйДокумент;
		
		//++ смарт:ММ 572 28.07.2021
		// Заполнение авто
		Если ЗначениеЗаполнено(НомерАвто) ИЛИ ЗначениеЗаполнено(НазваниеАвто) Тогда
			ИмяОбласти = ТабДок.НайтиТекст("(тип, марка, грузоподъемность (в тоннах), вместимость (в кубических метрах)").Имя;
			НомерСимвола = СтрНайти(ИмяОбласти, "C");
			КонецИмени = Сред(ИмяОбласти, НомерСимвола, СтрДлина(ИмяОбласти) - НомерСимвола + 1);
			НомерСтроки = Сред(ИмяОбласти, 2, НомерСимвола - 2);
			
			НомерКолонки = Прав(ИмяОбласти, СтрДлина(ИмяОбласти) - НомерСимвола);
			
			Попытка
				НомерСтрокиТС = Число(НомерСтроки);
				ТабДок.Область("R" + (НомерСтрокиТС - 3) + КонецИмени).Текст = НазваниеАвто;  
				
				НомерКолонки = Число(НомерКолонки) + 28;
				ТабДок.Область("R" + (НомерСтрокиТС - 1) + "C" + НомерКолонки).Текст = НомерАвто;  
			Исключение
			КонецПопытки;
		КонецЕсли;
		//-- смарт:ММ 28.07.2021
		
		//++ смарт:ММ 572 26.08.2021
		// Заполнение номера заказа
		НомерЗаказа = ДокСсылка.СчетНаОплатуПокупателю.Номер;
		НомерЗаказа = НомерЗаказа;//ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(НомерЗаказа, Истина, Истина);
		ТабДок.Область("R8C46:R8C56").Текст = НомерЗаказа;
		
		ТабДок.Область("R8C32:R8C40").Текст = ДокСсылка.СчетНаОплатуПокупателю.Дата;
		//-- смарт:ММ 26.08.2021
		
		//++ смарт:ММ 663 01.10.2021 
		ТабДок.Область("R8C18:R8C28").Текст = ДокСсылка.Номер;
		//-- смарт:ММ 01.10.2021
	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции //-- смарт:ММ 14.07.2021

