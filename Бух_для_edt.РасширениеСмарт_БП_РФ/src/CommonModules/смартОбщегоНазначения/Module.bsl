//Функция ПолучитьПараметрыОтправки(МассивАдресов, Данные, МассивАдресовКопия = Неопределено, ТестовыеАдресаМассив = Неопределено, ТестовыеАдресаСтрока = "", ЭтоТестоваяБаза = Ложь, Важность = Неопределено, ФорматироватьТекст = Истина) Экспорт
Функция ПолучитьПараметрыОтправки(МассивАдресов, Данные, МассивАдресовКопия = Неопределено, ТестовыеАдресаМассив = Неопределено, ТестовыеАдресаСтрока = "", ЭтоТестоваяБаза = Ложь, Важность = Неопределено, ФорматироватьТекст = Истина, ВыводитьПодписьНеТребуетОтвета = Истина) Экспорт
//-- смарт:ММ 20.07.2021
	ДанныеДляОтправки = Новый Структура;
	
	ДанныеДляОтправки.Вставить("Кому",	 	МассивАдресов);
	ДанныеДляОтправки.Вставить("Тема", 		Данные.Тема);

	Если НЕ ФорматироватьТекст Тогда
		ДанныеДляОтправки.Вставить("Тело", 	Данные.Заголовок);	
	Иначе
		//++ смарт:ММ 572 20.07.2021
		//ДанныеДляОтправки.Вставить("Тело", ПолучитьФорматированныйТекст(Данные));
		ДанныеДляОтправки.Вставить("Тело", ПолучитьФорматированныйТекст(Данные, ВыводитьПодписьНеТребуетОтвета));
		//-- смарт:ММ 20.07.2021
	КонецЕсли;
	
	ДанныеДляОтправки.Вставить("ТипТекста",	ТипТекстаПочтовогоСообщения.HTML);
	 
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		ВажностьСообщения = ВажностьИнтернетПочтовогоСообщения.Обычная;
	Иначе
		ВажностьСообщения = Важность;
	КонецЕсли;
	
	ДанныеДляОтправки.Вставить("Важность", ВажностьСообщения);
	
	Если МассивАдресовКопия <> Неопределено 
		И НЕ ЭтоТестоваяБаза Тогда
		ДанныеДляОтправки.Вставить("Копии", МассивАдресовКопия);
	КонецЕсли;
			
	ДанныеДляОтправки.Вставить("ТестовыеАдреса", "");
	ДанныеДляОтправки.Вставить("ТестоваяБаза", ЭтоТестоваяБаза);
	
	Если ЗначениеЗаполнено(ТестовыеАдресаМассив) 
		И ТестовыеАдресаМассив.Количество() > 0 Тогда
		
		ДанныеДляОтправки.Вставить("ТестовыеАдреса", ТестовыеАдресаСтрока);
		ДанныеДляОтправки.Вставить("Кому", ТестовыеАдресаМассив);	
	КонецЕсли;
	
	Если Данные.Свойство("Вложения") Тогда
		ДанныеДляОтправки.Вставить("Вложения", Данные.Вложения);
	КонецЕсли;
	
	Возврат ДанныеДляОтправки;
	
КонецФункции //-- смарт:ММ 06.07.2021

