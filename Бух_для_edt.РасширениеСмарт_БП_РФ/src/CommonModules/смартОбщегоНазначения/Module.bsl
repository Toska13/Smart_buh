Функция ПолучитьФорматированныйТекст(ДанныеОтправки, ВыводитьПодписьНеТребуетОтвета = Истина)
	
	Док = Новый ФорматированныйДокумент;
	
	мЗаголовок = Док.Добавить("Уведомление.", ТипЭлементаФорматированногоДокумента.Текст);
	мЗаголовок.Шрифт = Новый Шрифт("Arial", 16, Истина);
	
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	
	КоличествоЭлементов = Док.Элементы[0].Элементы.Количество();
	
	Абзац = Док.Добавить(ДанныеОтправки.Заголовок, ТипЭлементаФорматированногоДокумента.Текст);
	
	Для Сч = КоличествоЭлементов + 1 По Док.Элементы[0].Элементы.Количество() Цикл 
		Если ТипЗнч(Док.Элементы[0].Элементы[Сч-1]) = Тип("ТекстФорматированногоДокумента") Тогда 
			Док.Элементы[0].Элементы[Сч-1].Шрифт = Новый Шрифт("Arial", 12);
		КонецЕсли;
	КонецЦикла;
	
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
		
	//++ смарт:ММ 572 20.07.2021
	Если ВыводитьПодписьНеТребуетОтвета Тогда
	//-- смарт:ММ 20.07.2021
	
	Подпись = Док.Добавить("Письмо создано роботом и не требует ответа.", ТипЭлементаФорматированногоДокумента.Текст);
	
	Подпись.Шрифт = Новый Шрифт("Arial", 8);
	
	//++ смарт:ММ 572 20.07.2021
	КонецЕсли;
	//-- смарт:ММ 20.07.2021

	Возврат Док;
	
КонецФункции //-- смарт:ММ 06.07.2021

