		КонецЕсли;	
		//-- #1228 смарт: Фролов 24.11.2022
		ОбластьШапка.Параметры.КолПаллет = 1;
		//ОбластьШапка.Параметры.КолЦелыхПаллет = 1;
		
		ТабДок.Вывести(ОбластьШапка);

		ЕстьДанные = Истина;
	КонецЦикла;	
			
	Если ЕстьДанные Тогда
		ИмяФайла = "Заявка на машину по заказу клиента №" + Выборка.Номер + "." + РасширениеФайла;
		Возврат ТабДок;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
