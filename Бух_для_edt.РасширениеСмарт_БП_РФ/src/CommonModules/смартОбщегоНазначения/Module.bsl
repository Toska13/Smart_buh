	Если ПроксиWS = Неопределено Тогда
		ПроксиWS = ПодключениеК_УТ();	
	КонецЕсли;
	
	Если ПроксиWS = Неопределено Тогда
		Возврат РезультатТабДок;
	КонецЕсли;
	
	Макет = ПолучитьОбщийМакет("смартЗаявкаНаОтгрузку");
		
	НазваниеДокумента = НСтр("ru = 'Заявка на отгрузку'");
	
	ОбластьЗаголовка = Макет.ПолучитьОбласть("ЗаголовокПеремещение");	
