Функция ПолучитьИмяФайлаДляБуфераОбмена(ДокСсылка) Экспорт
	
	РезультатВозврат = "";
	
	Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		СчетФактура = Документы.СчетФактураВыданный.ПустаяСсылка();//rnp 06.10.2021
		СчетФактура = НайтиПодчиненныйСчетФактуруВыданныйНаРеализацию(ДокСсылка);

		Если НЕ ЗначениеЗаполнено(СчетФактура) Тогда
			//Возврат РезультатВозврат; //rnp 06.10.2021  закомментировано
		КонецЕсли;
		
		СчетНаОплатуПокупателю = ДокСсылка.СчетНаОплатуПокупателю;
		
		Если НЕ ЗначениеЗаполнено(СчетНаОплатуПокупателю) Тогда
			//Возврат РезультатВозврат; //rnp 06.10.2021 закомментировано, заказ не может быть пустым
		КонецЕсли;

		ИмяКонтрагента = Лев(СокрЛП(СтрЗаменить(ДокСсылка.Контрагент.Наименование, "ООО", "")), 100);
		
		//++ смарт:ММ 572 06.10.2021 - ругается на длинное наименование
		ИмяКонтрагента = Лев(ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяКонтрагента, ""), 50);
		//-- смарт:ММ 06.10.2021
		//++rnp 06.10.2021
		Если Не ЗначениеЗаполнено(СчетФактура) Тогда
			РезультатВозврат = "СФ " + ДокСсылка.Номер + " " + Формат(ДокСсылка.Дата, "ДЛФ=D") + " (Счет " + СчетНаОплатуПокупателю.Номер + " " + Формат(СчетНаОплатуПокупателю.Дата, "ДЛФ=D") + ") " + ИмяКонтрагента;	
		Иначе//--rnp 06.10.2021
			РезультатВозврат = "СФ " + СчетФактура.Номер + " " + Формат(СчетФактура.Дата, "ДЛФ=D") + " (Счет " + СчетНаОплатуПокупателю.Номер + " " + Формат(СчетНаОплатуПокупателю.Дата, "ДЛФ=D") + ") " + ИмяКонтрагента;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатВозврат;
	
КонецФункции //-- смарт:ММ 04.07.2021

