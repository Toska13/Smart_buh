		|	СкладысмартАдресаДляОтправкиПакетаНаСклад.Ссылка = &Склад"); 
	Запрос.УстановитьПараметр("Склад",ДокСсылка.Склад); 
	МассивАдресов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Адрес");	
	//-- #1353 смарт: Фролов 18.05.2023
	Если МассивАдресов.Количество() > 0 Тогда
		
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки = Новый Массив;
		
		Для Каждого АдресСтрока Из МассивАдресов Цикл
			МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес,Представление", АдресСтрока, АдресСтрока));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + АдресСтрока;
		КонецЦикла;
		
		Вложения = Новый Массив;

		Для Каждого СтруктураВложение Из МассивСтруктурВложений Цикл		
			ДанныеВложения = Новый Структура();
			ДанныеВложения.Вставить("Представление", СтруктураВложение.ИмяФайла);
			ДанныеВложения.Вставить("АдресВоВременномХранилище", СтруктураВложение.АдресХранилища);
			Вложения.Добавить(ДанныеВложения);
		КонецЦикла;
				
		//++ смарт:ММ 572 20.07.2021
		//УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("buh@smart-t.ru");
		//-- смарт:ММ 20.07.2021
		
		ТемаПисьма = "Пакет документов " + ПолучитьИмяФайлаДляБуфераОбмена(ДокСсылка);
		ТекстПисьма = "Во вложении прикреплен " + ТемаПисьма;
		
		ДанныеОтправки = Новый Структура("Тема,Заголовок,Вложения", ТемаПисьма, ТекстПисьма, Вложения);
			
		//++ смарт:ММ 572 20.07.2021
		//ПараметрыПисьма = ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, ,,,,,, Ложь);

		ПараметрыПисьма.Вставить("АдресОтвета", "buh@smart-t.ru");
		//-- смарт:ММ 20.07.2021
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);			
			
			ТекстСообщения = "Пакет документов отправлен на электронную почту " + АдресаДляОтправкиСтрокой;
						
			ЗаписьЖурналаРегистрации("смартОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Исключение
			ТекстСообщения = "Не удалось отправить пакет документов на электронную почту" + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("смартОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;

		Для Каждого СтруктураВложение Из МассивСтруктурВложений Цикл
			УдалитьИзВременногоХранилища(СтруктураВложение.АдресХранилища);
		КонецЦикла;
	КонецЕсли;

