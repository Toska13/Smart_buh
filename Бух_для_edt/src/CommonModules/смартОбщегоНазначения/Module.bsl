Процедура ОтправитьКорректировкуДолга(Параметры, Адрес) Экспорт
	
	ОбщегоНазначенияБТС.Пауза(5);
	
	ИсточникДанных = Параметры.Источник;
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("ВерсияФормата", "1.7");
	
	ТзДополнительнаяРегистрация = Новый ТаблицаЗначений;
	ТзДополнительнаяРегистрация.Колонки.Добавить("ВыборПериода", Новый ОписаниеТипов("Булево"));
	ТзДополнительнаяРегистрация.Колонки.Добавить("Количество", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТзДополнительнаяРегистрация.Колонки.Добавить("Отбор");
	ТзДополнительнаяРегистрация.Колонки.Добавить("ОтборСтрокой", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТзДополнительнаяРегистрация.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТзДополнительнаяРегистрация.Колонки.Добавить("ПолноеИмяМетаданных", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТзДополнительнаяРегистрация.Колонки.Добавить("Представление", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	ПользовательскиеОтборы = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	ЭлементОтбора = ПользовательскиеОтборы.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ИсточникДанных;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.Применение = ТипПримененияОтбораКомпоновкиДанных.Элементы;
	
	СтандартПериод = Новый СтандартныйПериод;
	СтандартПериод.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	
	НоваяСтрокаТЗрегистрации = ТзДополнительнаяРегистрация.Добавить();
	НоваяСтрокаТЗрегистрации.ВыборПериода = Ложь;
	НоваяСтрокаТЗрегистрации.Количество = "";
	НоваяСтрокаТЗрегистрации.Отбор = ПользовательскиеОтборы;
	НоваяСтрокаТЗрегистрации.ОтборСтрокой = Строка(ПользовательскиеОтборы);
	НоваяСтрокаТЗрегистрации.Период = СтандартПериод;
	НоваяСтрокаТЗрегистрации.ПолноеИмяМетаданных = "Документ.КорректировкаДолга";
	НоваяСтрокаТЗрегистрации.Представление = "КорректировкаДолга";
	
	СтруктураПараметров.Вставить("МестоВыгрузки", 1);
	СтруктураПараметров.Вставить("ПериодОтбораВсехДокументов", СтандартПериод);
	СтруктураПараметров.Вставить("ПутьКМенеджеруОбменаВыгрузки", "");
	СтруктураПараметров.Вставить("УзелОбмена", Неопределено);
	СтруктураПараметров.Вставить("ЭтоФоновоеЗадание", Истина);
	СтруктураПараметров.Вставить("ДополнительнаяРегистрация", ТзДополнительнаяРегистрация);
	
	Обработка = Обработки.ВыгрузкаЗагрузкаEnterpriseData.Создать();
	РезультатВыгрузки = Обработка.РезультатВыгрузкиВXML(СтруктураПараметров);
	XMLответ = ПолучитьИзВременногоХранилища(РезультатВыгрузки);
	
	ДобавитьДанныеДляОтправкиВУТ(XMLответ, "/hs/smartaddocum/add/offset", ИсточникДанных);
	
КонецПроцедуры

Процедура ОтправитьОперациюБухСторно(Параметры, Адрес) Экспорт
	
	ОбщегоНазначенияБТС.Пауза(5);
	
	ИсточникДанных=Параметры.Источник.СторнируемыйДокумент;
	
	ДобавитьДанныеДляОтправкиВУТ("", СтрШаблон("/hs/smartaddocum/add/operation?Number=%1&Date=%2&DateOperation=%3", ИсточникДанных.Номер, ИсточникДанных.Дата, Параметры.Источник.Дата), ИсточникДанных);
	
КонецПроцедуры

//++ #Б5136 смарт: Шляпников 27.01.2026 / Маркировка радиоэлектронной продукции. Синхронизация данных. Приемка товара.
Процедура ОтправитьОчередьСообщенийВУТ() Экспорт
	
	БазаУТ = сокрЛП(Справочники.смартПредопределенныеЗначения.БазаУТ.Значение);
	СерверУТ = сокрЛП(Справочники.смартПредопределенныеЗначения.СерверУТ.Значение);
	
	Если НЕ ЗначениеЗаполнено(БазаУТ) ИЛИ НЕ ЗначениеЗаполнено(СерверУТ) Тогда
		ЗаписьЖурналаРегистрации("смартОбменСУТ.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, "Данные не будут перенесены в УТ, т.к. не заполнены предпределенные значения справочника смартПредопределенныеЗначения(БазаУТ,СерверУТ)",);
		Возврат;
	КонецЕсли;  
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартОчередьСообщенийВУТ.ИД КАК ИД,
	|	смартОчередьСообщенийВУТ.ДатаСоздания КАК ДатаСоздания,
	|	смартОчередьСообщенийВУТ.Адрес КАК Адрес,
	|	смартОчередьСообщенийВУТ.Сообщение КАК Сообщение,
	|	смартОчередьСообщенийВУТ.Отправлено КАК Отправлено,
	|	смартОчередьСообщенийВУТ.КоличествоПопыток КАК КоличествоПопыток,
	|	смартОчередьСообщенийВУТ.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.смартОчередьСообщенийВУТ КАК смартОчередьСообщенийВУТ
	|ГДЕ
	|	НЕ смартОчередьСообщенийВУТ.Отправлено
	|	И смартОчередьСообщенийВУТ.КоличествоПопыток < 3
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		// создаем новое HTTP соединение с указанием сервера
		HTTP = Новый HTTPСоединение(СерверУТ, 443, "Администратор", "19320998",,, Новый ЗащищенноеСоединениеOpenSSL);
		
		//получим временный файл для передачи в теле POST-запроса
		ФайлТелаЗапроса = ПолучитьИмяВременногоФайла();
		//запишем в файл содержимое тела запроса (текст)
		ТекстФайл = Новый ТекстовыйДокумент;
		ТекстФайл.УстановитьТекст(Выборка.Сообщение);
		ТекстФайл.Записать(ФайлТелаЗапроса, КодировкаТекста.UTF8);
		//получим размер данных для передачи в заголовок
		ФайлНаОтправку = Новый Файл(ФайлТелаЗапроса);
		РазмерФайлаНаОтправку = XMLСтрока(ФайлНаОтправку.Размер());
		
		//заголовок создадим в виде соответствия
		ЗаголовокЗапросаHTTP = Новый Соответствие();
		//передаем в заголовках размер и тип данных на отправку
		ЗаголовокЗапросаHTTP.Вставить("Content-Length", РазмерФайлаНаОтправку);
		ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/xml; charset=utf-8");
		
		ЗапросHTTP = Новый HTTPЗапрос(СтрШаблон("%1%2", БазаУТ , Выборка.Адрес), ЗаголовокЗапросаHTTP);

		//загрузить строку в тело
		ЗапросHTTP.УстановитьИмяФайлаТела(ФайлТелаЗапроса);
		
		//отсылаем POST-запрос на обработку.
		ОтветHTTP = HTTP.ОтправитьДляОбработки(ЗапросHTTP);
		ОтветПользователю = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");
		
		Если ОтветHTTP.КодСостояния = 200 Тогда
			
			рег = РегистрыСведений.смартОчередьСообщенийВУТ.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(рег, Выборка);
			рег.ДатаОтправки = ТекущаяДата();
			рег.Отправлено = Истина;
			рег.Ошибка = Ложь;
			рег.КоличествоПопыток = Выборка.КоличествоПопыток + 1;
			рег.ТекстОшибки = "";
			рег.Записать(Истина);
			
			Если ЗначениеЗаполнено(Выборка.Объект) Тогда
				
				МенеджерЗаписи = РегистрыСведений.смартОтправленыВУТ.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.ОбъектОтправки = Выборка.Объект;
				МенеджерЗаписи.Сообщение = ОтветПользователю;
				МенеджерЗаписи.Статус = Истина;
				МенеджерЗаписи.ОтправленXML = Выборка.Сообщение;
				МенеджерЗаписи.Записать();
				
			КонецЕсли;
			
		Иначе
			
			рег = РегистрыСведений.смартОчередьСообщенийВУТ.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(рег, Выборка);
			рег.ДатаОтправки = ТекущаяДата();
			рег.Отправлено = Ложь;
			рег.Ошибка = Истина;
			рег.КоличествоПопыток = Выборка.КоличествоПопыток + 1;
			рег.ТекстОшибки = ОтветПользователю;
			рег.Записать(Истина);
			
			Если ЗначениеЗаполнено(Выборка.Объект) Тогда
				
				МенеджерЗаписи = РегистрыСведений.смартОтправленыВУТ.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.ОбъектОтправки = Выборка.Объект;
				МенеджерЗаписи.Сообщение = ОтветПользователю;
				МенеджерЗаписи.Статус = Ложь;
				МенеджерЗаписи.ОтправленXML = Выборка.Сообщение;
				МенеджерЗаписи.Записать();
				
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации("смартОбменСУТ.Ошибка", УровеньЖурналаРегистрации.Ошибка,,, ОтветПользователю,);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

