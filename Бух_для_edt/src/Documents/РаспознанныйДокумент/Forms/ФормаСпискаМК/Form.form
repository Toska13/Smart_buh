  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ОтражениеВУчете</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ВариантОбработки</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Дата</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Идентификатор</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ИмяФайла</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.КоличествоСтрокТаблицы</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ПометкаУдаления</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Статус</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ТипДокумента</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ЭтоЗаданиеРаспознавания</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Т.СтатусРаспознавания КАК СтатусРаспознавания,
	Т.Идентификатор КАК Идентификатор,
	Т.ПометкаУдаления КАК ПометкаУдаления,
	Т.Номер КАК Номер,
	Т.Дата КАК Дата,
	Т.ПредставлениеДаты КАК ПредставлениеДаты,
	Т.Проведен КАК Проведен,
	Т.ТипДокумента КАК ТипДокумента,
	Т.Статус КАК Статус,
	Т.ШиринаИзображения КАК ШиринаИзображения,
	Т.ВысотаИзображения КАК ВысотаИзображения,
	Т.Контрагент КАК Контрагент,
	Т.Организация КАК Организация,
	Т.Наименование КАК Наименование,
	Т.ИмяФайла КАК ИмяФайла,
	Т.Ссылка КАК Ссылка,
	Т.Источник КАК Источник,
	Т.Направление КАК Направление,
	Т.ЭтоЗаданиеРаспознавания КАК ЭтоЗаданиеРаспознавания,
	Т.СтатусСвязанногоДокумента КАК СтатусСвязанногоДокумента,
	Т.КоличествоСтрокТаблицы КАК КоличествоСтрокТаблицы,
	Т.ВариантОбработки КАК ВариантОбработки,
	Т.ЕстьДубль КАК ЕстьДубль
ИЗ
	(ВЫБРАТЬ
		3 КАК СтатусРаспознавания,
		ИсходныеДанныеЗаданийРаспознаваниеДокументов.ИдентификаторЗадания КАК Идентификатор,
		СостоянияЗаданийРаспознаваниеДокументов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыНаСервисеРаспознаваниеДокументов.Отменено) КАК ПометкаУдаления,
		&quot;&quot; КАК Номер,
		ИсходныеДанныеЗаданийРаспознаваниеДокументов.ДатаЗагрузки КАК Дата,
		ДОБАВИТЬКДАТЕ(ИсходныеДанныеЗаданийРаспознаваниеДокументов.ДатаЗагрузки, СЕКУНДА, &amp;ПоправкаВремени) КАК ПредставлениеДаты,
		ЛОЖЬ КАК Проведен,
		ЗНАЧЕНИЕ(Перечисление.ТипыДокументовРаспознаваниеДокументов.ПустаяСсылка) КАК ТипДокумента,
		ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.ПустаяСсылка) КАК Статус,
		0 КАК ШиринаИзображения,
		0 КАК ВысотаИзображения,
		&quot;&quot; КАК Контрагент,
		&quot;&quot; КАК Организация,
		ИсходныеДанныеЗаданийРаспознаваниеДокументов.ИмяФайла КАК Наименование,
		&quot;&quot; КАК ИмяФайла,
		ЗНАЧЕНИЕ(Документ.РаспознанныйДокумент.ПустаяСсылка) КАК Ссылка,
		ВЫБОР
			КОГДА ПредставлениеЗаданийРаспознаваниеДокументов.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПолученияФайлов.ПустаяСсылка)
				ТОГДА ИсходныеДанныеЗаданийРаспознаваниеДокументов.Отправитель
			КОГДА ПредставлениеЗаданийРаспознаваниеДокументов.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПолученияФайлов.Вручную)
				ТОГДА ИсходныеДанныеЗаданийРаспознаваниеДокументов.Пользователь
			КОГДА ПредставлениеЗаданийРаспознаваниеДокументов.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПолученияФайлов.ЭлектроннаяПочта)
				ТОГДА ИсходныеДанныеЗаданийРаспознаваниеДокументов.Отправитель
			ИНАЧЕ ПредставлениеЗаданийРаспознаваниеДокументов.Источник
		КОНЕЦ КАК Источник,
		0 КАК Направление,
		ИСТИНА КАК ЭтоЗаданиеРаспознавания,
		0 КАК СтатусСвязанногоДокумента,
		0 КАК КоличествоСтрокТаблицы,
		ЗНАЧЕНИЕ(Перечисление.ВариантыОбработкиЗаданияРаспознавания.ПустаяСсылка) КАК ВариантОбработки,
		ЛОЖЬ КАК ЕстьДубль
	ИЗ
		РегистрСведений.ИсходныеДанныеЗаданийРаспознаваниеДокументов КАК ИсходныеДанныеЗаданийРаспознаваниеДокументов
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредставлениеЗаданийРаспознаваниеДокументов КАК ПредставлениеЗаданийРаспознаваниеДокументов
			ПО ИсходныеДанныеЗаданийРаспознаваниеДокументов.ИдентификаторЗадания = ПредставлениеЗаданийРаспознаваниеДокументов.ИдентификаторЗадания
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаданийРаспознаваниеДокументов КАК СостоянияЗаданийРаспознаваниеДокументов
			ПО ИсходныеДанныеЗаданийРаспознаваниеДокументов.ИдентификаторЗадания = СостоянияЗаданийРаспознаваниеДокументов.ИдентификаторЗадания
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РезультатыОбработкиЗаданийРаспознаваниеДокументов КАК Соотв
			ПО ИсходныеДанныеЗаданийРаспознаваниеДокументов.ИдентификаторФайла = Соотв.ИдентификаторФайла
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РаспознанныйДокумент КАК РаспознанныйДокумент
			ПО (Соотв.ИдентификаторРезультата = РаспознанныйДокумент.ИдентификаторРезультата)
	ГДЕ
		ИсходныеДанныеЗаданийРаспознаваниеДокументов.ВОбработке
		И СостоянияЗаданийРаспознаваниеДокументов.Статус &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусыНаСервисеРаспознаваниеДокументов.Отменено)
		И СостоянияЗаданийРаспознаваниеДокументов.Статус &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусыНаСервисеРаспознаваниеДокументов.Ошибка)
		И ЕСТЬNULL(РаспознанныйДокумент.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.Новый)) &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.Ошибка)
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ВЫБОР
			КОГДА ДокументРаспознанныйДокумент.ПометкаУдаления
				ТОГДА 0
			ИНАЧЕ ВЫБОР
					КОГДА ДокументРаспознанныйДокумент.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.Ошибка)
						ТОГДА 1
					КОГДА ДокументРаспознанныйДокумент.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.Новый)
						ТОГДА 2
					КОГДА ДокументРаспознанныйДокумент.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.Обработан)
						ТОГДА 4
					ИНАЧЕ 3
				КОНЕЦ
		КОНЕЦ,
		ДокументРаспознанныйДокумент.ИдентификаторРезультата,
		ДокументРаспознанныйДокумент.ПометкаУдаления,
		ДокументРаспознанныйДокумент.Номер,
		ДокументРаспознанныйДокумент.Дата,
		ДОБАВИТЬКДАТЕ(ДокументРаспознанныйДокумент.Дата, СЕКУНДА, &amp;ПоправкаВремени),
		ДокументРаспознанныйДокумент.Проведен,
		ДокументРаспознанныйДокумент.ТипДокумента,
		ВЫБОР
			КОГДА ДокументРаспознанныйДокумент.ПометкаУдаления
				ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.Удален)
			ИНАЧЕ ДокументРаспознанныйДокумент.Статус
		КОНЕЦ,
		ДокументРаспознанныйДокумент.ШиринаИзображения,
		ДокументРаспознанныйДокумент.ВысотаИзображения,
		ВЫБОР
			КОГДА НЕ ДокументРаспознанныйДокумент.Организация = &quot;&quot;
					И ДокументРаспознанныйДокумент.Контрагент = &quot;&quot;
				ТОГДА ДокументРаспознанныйДокумент.Организация
			ИНАЧЕ ДокументРаспознанныйДокумент.Контрагент
		КОНЕЦ,
		ВЫБОР
			КОГДА НЕ ДокументРаспознанныйДокумент.Контрагент = &quot;&quot;
					И ДокументРаспознанныйДокумент.Организация = &quot;&quot;
				ТОГДА ДокументРаспознанныйДокумент.Контрагент
			ИНАЧЕ ДокументРаспознанныйДокумент.Организация
		КОНЕЦ,
		ДокументРаспознанныйДокумент.Наименование,
		ДокументРаспознанныйДокумент.ИмяФайла,
		ДокументРаспознанныйДокумент.Ссылка,
		ВЫБОР
			КОГДА ДокументРаспознанныйДокумент.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПолученияФайлов.ПустаяСсылка)
				ТОГДА ДокументРаспознанныйДокумент.Отправитель
			КОГДА ДокументРаспознанныйДокумент.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПолученияФайлов.Вручную)
				ТОГДА ДокументРаспознанныйДокумент.Ответственный
			КОГДА ДокументРаспознанныйДокумент.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиПолученияФайлов.ЭлектроннаяПочта)
				ТОГДА ДокументРаспознанныйДокумент.Отправитель
			ИНАЧЕ ДокументРаспознанныйДокумент.Источник
		КОНЕЦ,
		ВЫБОР
			КОГДА ДокументРаспознанныйДокумент.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияРаспознанногоДокумента.Входящий)
				ТОГДА 2
			КОГДА ДокументРаспознанныйДокумент.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияРаспознанногоДокумента.Исходящий)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ,
		ЛОЖЬ,
		ЕСТЬNULL(СвязанныеОбъектыРаспознаниеДокументов.СтатусСвязанногоДокумента, 0),
		ДокументРаспознанныйДокумент.КоличествоРаспознанныхСущностей,
		ДокументРаспознанныйДокумент.ВариантОбработки,
		ЕСТЬNULL(ДублиДокументов.ЕстьДубль, ЛОЖЬ)
	ИЗ
		Документ.РаспознанныйДокумент КАК ДокументРаспознанныйДокумент
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				Т.РаспознанныйДокумент КАК РаспознанныйДокумент,
				ВЫБОР
					КОГДА КОЛИЧЕСТВО(Т.РаспознанныйДокумент) = 0
						ТОГДА 0
					КОГДА МАКСИМУМ(Т.ПотенциальныйКандидат)
						ТОГДА 1
					ИНАЧЕ 2
				КОНЕЦ КАК СтатусСвязанногоДокумента
			ИЗ
				РегистрСведений.СвязанныеОбъектыРаспознаниеДокументов КАК Т
			
			СГРУППИРОВАТЬ ПО
				Т.РаспознанныйДокумент) КАК СвязанныеОбъектыРаспознаниеДокументов
			ПО ДокументРаспознанныйДокумент.Ссылка = СвязанныеОбъектыРаспознаниеДокументов.РаспознанныйДокумент
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				КОЛИЧЕСТВО(РаспознанныйДокумент.Ссылка) КАК Количество,
				РаспознанныйДокумент.НомерДокумента КАК НомерДокумента,
				РаспознанныйДокумент.ДатаДокумента КАК ДатаДокумента,
				РаспознанныйДокумент.Контрагент КАК Контрагент,
				РаспознанныйДокумент.Организация КАК Организация,
				РаспознанныйДокумент.СуммаДокумента КАК СуммаДокумента,
				ИСТИНА КАК ЕстьДубль
			ИЗ
				Документ.РаспознанныйДокумент КАК РаспознанныйДокумент
			ГДЕ
				РаспознанныйДокумент.Контрагент &lt;> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				И РаспознанныйДокумент.Организация &lt;> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				И РаспознанныйДокумент.Статус &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.Ошибка)
				И НЕ РаспознанныйДокумент.ПометкаУдаления
			
			СГРУППИРОВАТЬ ПО
				РаспознанныйДокумент.НомерДокумента,
				РаспознанныйДокумент.ДатаДокумента,
				РаспознанныйДокумент.Контрагент,
				РаспознанныйДокумент.Организация,
				РаспознанныйДокумент.СуммаДокумента
			
			ИМЕЮЩИЕ
				КОЛИЧЕСТВО(РаспознанныйДокумент.Ссылка) > 1) КАК ДублиДокументов
			ПО ДокументРаспознанныйДокумент.НомерДокумента = ДублиДокументов.НомерДокумента
				И ДокументРаспознанныйДокумент.ДатаДокумента = ДублиДокументов.ДатаДокумента
				И ДокументРаспознанныйДокумент.Контрагент = ДублиДокументов.Контрагент
				И ДокументРаспознанныйДокумент.Организация = ДублиДокументов.Организация
				И ДокументРаспознанныйДокумент.СуммаДокумента = ДублиДокументов.СуммаДокумента
	ГДЕ
		ДокументРаспознанныйДокумент.Статус &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусыСозданныхДокументовРаспознаваниеДокументов.ПустаяСсылка)) КАК Т</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
