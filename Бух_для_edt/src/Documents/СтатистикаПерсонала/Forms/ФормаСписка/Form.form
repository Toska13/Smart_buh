    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументСтатистикаПерсонала.Ссылка,
	ДокументСтатистикаПерсонала.ПометкаУдаления,
	ДокументСтатистикаПерсонала.Номер,
	ДокументСтатистикаПерсонала.Дата,
	ДокументСтатистикаПерсонала.Проведен,
	ДокументСтатистикаПерсонала.Организация,
	ДокументСтатистикаПерсонала.Ответственный,
	ДокументСтатистикаПерсонала.Комментарий,
	ДокументСтатистикаПерсонала.ПериодРегистрации,
	ДокументСтатистикаПерсонала.Показатели,
	ДокументСтатистикаПерсонала.ДополнительныеРеквизиты,
	ВЫБОР
		КОГДА ДокументСтатистикаПерсонала.ПометкаУдаления = ИСТИНА
			ТОГДА 2
		КОГДА ДокументСтатистикаПерсонала.Проведен = ИСТИНА
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК СостояниеДокумента,
	ДокументСтатистикаПерсонала.МоментВремени
ИЗ
	Документ.СтатистикаПерсонала КАК ДокументСтатистикаПерсонала</queryText>
      <mainTable>Document.СтатистикаПерсонала</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
