<?xml version="1.0" encoding="UTF-8"?>
<form:Form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:form="http://g5.1c.ru/v8/dt/form">
  <title>
    <key>ru</key>
    <value>Как исправить расхождения при сверке разметки АУСН</value>
  </title>
  <items xsi:type="form:Decoration">
    <name>ПереченьНеИнтегрированныхБанков</name>
    <id>10</id>
    <title>
      <key>ru</key>
      <value>&lt;b>Если банк не интегрирован с сервисом АУСН&lt;/></value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ПереченьНеИнтегрированныхБанковРасширеннаяПодсказка</name>
      <id>12</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ПереченьНеИнтегрированныхБанковКонтекстноеМеню</name>
      <id>11</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <formatted>true</formatted>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <horizontalStretch>true</horizontalStretch>
    <font xsi:type="core:FontRef">
      <font>Style.NormalTextFont</font>
      <bold>true</bold>
      <italic>false</italic>
      <underline>false</underline>
      <strikeout>false</strikeout>
      <scale>100</scale>
    </font>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
    </extInfo>
  </items>
  <items xsi:type="form:Decoration">
    <name>ИнструкцияНеИнтегрированныеБанки</name>
    <id>13</id>
    <title>
      <key>ru</key>
      <value>&lt;font -apple-system>&lt;fontsize 12>&lt;b>&lt;bgcolor #ffffff>&lt;color #333333>• &lt;/>&lt;/>&lt;/>&lt;/>&lt;/>Убедитесь, что банковские операции в 1С размечены верно.
&lt;font -apple-system>&lt;fontsize 12>&lt;b>&lt;bgcolor #ffffff>&lt;color #333333>• &lt;/>&lt;/>&lt;/>&lt;/>&lt;/>Перейдите в личный кабинет банка, по операциям которого обнаружены расхождения.
&lt;font -apple-system>&lt;fontsize 12>&lt;b>&lt;bgcolor #ffffff>&lt;color #333333>• &lt;/>&lt;/>&lt;/>&lt;/>&lt;/>Откорректируйте разметку, чтобы суммы и признаки налоговой базы соответствовали той информации, которая отображается в программе.
&lt;font -apple-system>&lt;fontsize 12>&lt;b>&lt;bgcolor #ffffff>&lt;color #333333>• &lt;/>&lt;/>&lt;/>&lt;/>&lt;/>Дождитесь, когда банк передаст скорректированные данные в ФНС.
&lt;font -apple-system>&lt;fontsize 12>&lt;b>&lt;bgcolor #ffffff>&lt;color #333333>• &lt;/>&lt;/>&lt;/>&lt;/>&lt;/>После того, как в личном кабинете ФНС отобразятся изменения, скачайте файл с разметкой и проведите повторную сверку.</value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ИнструкцияНеИнтегрированныеБанкиРасширеннаяПодсказка</name>
      <id>15</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ИнструкцияНеИнтегрированныеБанкиКонтекстноеМеню</name>
      <id>14</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <formatted>true</formatted>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <extInfo xsi:type="form:LabelDecorationExtInfo">
      <horizontalAlign>Left</horizontalAlign>
    </extInfo>
  </items>
  <items xsi:type="form:Decoration">
    <name>ПереченьИнтегрированныхБанков</name>
    <id>16</id>
    <title>
      <key>ru</key>
      <value>&lt;b>Если банк интегрирован с сервисом АУСН&lt;/></value>
    </title>
    <visible>true</visible>
    <enabled>true</enabled>
    <userVisible>
      <common>true</common>
    </userVisible>
    <extendedTooltip>
      <name>ПереченьИнтегрированныхБанковРасширеннаяПодсказка</name>
      <id>18</id>
      <type>Label</type>
      <autoMaxWidth>true</autoMaxWidth>
      <autoMaxHeight>true</autoMaxHeight>
      <extInfo xsi:type="form:LabelDecorationExtInfo">
        <horizontalAlign>Left</horizontalAlign>
      </extInfo>
    </extendedTooltip>
    <contextMenu>
      <name>ПереченьИнтегрированныхБанковКонтекстноеМеню</name>
      <id>17</id>
      <autoFill>true</autoFill>
    </contextMenu>
    <formatted>true</formatted>
    <type>Label</type>
    <autoMaxHeight>true</autoMaxHeight>
    <horizontalStretch>true</horizontalStretch>
    <font xsi:type="core:FontRef">
      <font>Style.NormalTextFont</font>
      <bold>true</bold>
      <italic>false</italic>
      <underline>false</underline>
      <strikeout>false</strikeout>
