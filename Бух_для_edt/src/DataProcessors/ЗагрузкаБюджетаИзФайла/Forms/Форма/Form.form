      <items xsi:type="form:FormGroup">
        <name>ГруппаОтборНастройкаТаблицы</name>
        <id>141</id>
        <items xsi:type="form:FormField">
          <name>ОтборТаблицы</name>
          <id>105</id>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
          <dataPath xsi:type="form:DataPath">
            <segments>ОтборТаблицы</segments>
          </dataPath>
          <titleLocation>None</titleLocation>
          <toolTipRepresentation>Button</toolTipRepresentation>
          <extendedTooltip>
            <name>ОтборТаблицыРасширеннаяПодсказка</name>
            <id>107</id>
            <title>
              <key>ru</key>
              <value>В строках со знаком &quot;!&quot; необходимо выбрать из списка, так как было найдено несколько позиций с совпадающими реквизитами.
Строки со знаком &quot;+&quot; означают, что при загрузке автоматически будет создан новая статья или направление деятельности в зависимости от колонки. Также ее можно указать вручную.</value>
            </title>
            <type>Label</type>
            <autoMaxWidth>true</autoMaxWidth>
            <autoMaxHeight>true</autoMaxHeight>
            <extInfo xsi:type="form:LabelDecorationExtInfo">
              <horizontalAlign>Left</horizontalAlign>
            </extInfo>
          </extendedTooltip>
          <contextMenu>
            <name>ОтборТаблицыКонтекстноеМеню</name>
            <id>106</id>
            <autoFill>true</autoFill>
          </contextMenu>
          <type>RadioButtonField</type>
          <editMode>Enter</editMode>
          <showInHeader>true</showInHeader>
          <headerHorizontalAlign>Left</headerHorizontalAlign>
          <showInFooter>true</showInFooter>
          <extInfo xsi:type="form:RadioButtonsFieldExtInfo">
            <radioButtonsType>Tumbler</radioButtonsType>
            <choiceList>
              <presentation>
                <key>ru</key>
                <value>Все</value>
              </presentation>
              <value xsi:type="core:NumberValue">
                <value>0</value>
              </value>
            </choiceList>
            <choiceList>
              <presentation>
                <key>ru</key>
                <value>Найденные</value>
              </presentation>
              <value xsi:type="core:NumberValue">
                <value>1</value>
              </value>
            </choiceList>
            <choiceList>
              <presentation>
                <key>ru</key>
