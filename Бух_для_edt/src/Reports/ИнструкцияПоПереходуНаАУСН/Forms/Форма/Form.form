    <items xsi:type="form:Decoration">
      <name>ДеталиВыборВариантаПереходаНаАУСН</name>
      <id>53</id>
      <title>
        <key>ru</key>
        <value>&lt;font Arial>&lt;fontsize 10>&lt;bgcolor #ffffff>&lt;color #000000>• С начала календарного года&lt;/>&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>   - подходит для всех организаций и ИП&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>   - уведомление о переходе нужно подать в ФНС не позднее 31 декабря текущего года&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>• С начала любого месяца&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>   - подходит для организации и ИП на УСН, ИП на НПД&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>   - уведомление о переходе нужно подать в ФНС не позднее последнего дня месяца, предшествующего переходу&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>• С даты постановки на учет &lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>   - подходит для новых организаций и ИП&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;fontsize 10>   - уведомление о переходе нужно подать в ФНС в течение 30 календарных дней с даты постановки на учет&lt;/>&lt;/>&lt;/>
&lt;fontsize 12>&lt;color #000000>&lt;/>&lt;/>
</value>
      </title>
      <visible>true</visible>
      <enabled>true</enabled>
      <userVisible>
        <common>true</common>
      </userVisible>
      <extendedTooltip>
        <name>ДеталиВыборВариантаПереходаНаАУСНРасширеннаяПодсказка</name>
        <id>55</id>
